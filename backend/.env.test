# CoachX Backend — Test Environment
#
# Loaded automatically when NODE_ENV=test (see src/config/env.config.ts).
# Deliberately isolated from local development `.env`: safe to commit
# (no real secrets), and never points at a real database.

NODE_ENV=test
PORT=4001
API_PREFIX=/api
HOST=127.0.0.1

CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=error

# No DATABASE_URL on purpose — exercises the "database not configured"
# path in the readiness check without needing a real Postgres instance
# in CI. Tests that need a configured-but-unreachable DB set
# process.env.DATABASE_URL directly in that test file.

JWT_ACCESS_SECRET=test-only-access-secret
JWT_REFRESH_SECRET=test-only-refresh-secret

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
