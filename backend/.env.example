# ==================================================
# CoachX Backend — Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit the real .env file.
# ==================================================

# --- Server ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api
HOST=0.0.0.0

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Logging ---
LOG_LEVEL=debug

# --- Database (consumed via database/ Prisma package) ---
DATABASE_URL=postgresql://coachx:coachx@localhost:5432/coachx_dev?schema=public

# --- Auth (JWT) — placeholders only; real secrets are provisioned per environment ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Storage (Supabase) — placeholders only ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me
SUPABASE_STORAGE_BUCKET=coachx-uploads

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
