// CoachX Enterprise Platform — Prisma Schema
//
// Phase 3 (Database & Shared Data Architecture) scope: shared TECHNICAL
// models only — cross-cutting infrastructure every future business
// feature writes to or reads from, never a business/domain entity.
//
// Every model below has a specific, documented justification in
// docs/database/SCHEMA_OWNERSHIP.md — nothing here was added just to
// give Prisma something to generate. See that file's "What is
// deliberately NOT here yet" section for the models considered and
// rejected as premature (Tenant/Organization, transactional Outbox).
//
// Naming convention (see docs/database/ARCHITECTURE.md §1): PascalCase
// model names in the Prisma/TypeScript layer, mapped via @@map/@map to
// snake_case table/column names in actual PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AuditEvent — immutable, append-only audit trail.
//
// Owner: platform-wide (Constitution "Security & Compliance Baseline":
// "All administrative, financial, and AI-copilot actions are captured
// in an immutable audit log"; Constitution Article IV, Historical
// Immutability). Referenced by 001-product-vision-governance FR-077
// ("Every administrative configuration change MUST be recorded in an
// audit trail") and FR-096 (no sensitive data in plain text in logs).
//
// This is intentionally NOT a business entity owned by any single
// feature — it is the shared table every future feature's own
// audit-relevant actions (role changes, refunds, content publishes,
// AI-copilot actions, etc.) write into, the same way every feature
// already shares the backend's logger/error-handler from Phase 2.
//
// IMMUTABLE BY DESIGN: no `updatedAt` field and no soft-delete flag —
// unlike every other future table's standard pattern (see
// docs/database/ARCHITECTURE.md §9), an audit record is never updated
// or deleted after creation. If a recorded action turns out to be
// wrong, a NEW compensating AuditEvent is written; the original is
// never modified.
//
// Actor references are deliberately decoupled (nullable string IDs,
// not foreign keys) because Feature 003 (Authentication) does not
// exist yet — see docs/database/AUDITABILITY.md for the migration path
// once a real User table exists.
// ============================================================================
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid

  /// When the recorded action actually occurred (not when the row was
  /// written — for this table today the two are effectively the same,
  /// but the distinction matters once replayed/backfilled events exist).
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  /// Who performed the action. Decoupled from any auth table on purpose
  /// (see docs/database/AUDITABILITY.md) — `actorId` is just an opaque
  /// string today, not a foreign key.
  actorType ActorType @default(UNKNOWN) @map("actor_type")
  actorId   String?   @map("actor_id") @db.VarChar(191)

  /// What happened, in a dotted, namespaced form, e.g.
  /// "admin.membership_tier.updated", "ai.recommendation.generated".
  action String @db.VarChar(191)

  /// What the action was performed on, if applicable.
  resourceType String? @map("resource_type") @db.VarChar(191)
  resourceId   String? @map("resource_id") @db.VarChar(191)

  /// Cross-cutting request tracing — mirrors the backend's
  /// X-Request-Id (Phase 2, request-id.middleware.ts) so a single HTTP
  /// request's audit events can be reconstructed end-to-end.
  correlationId String? @map("correlation_id") @db.VarChar(191)
  requestId     String? @map("request_id") @db.VarChar(191)

  /// Which deployable produced this event — useful once more than one
  /// backend service exists (per 064's eventual service-mesh model).
  sourceService String @default("coachx-backend") @map("source_service") @db.VarChar(100)

  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(512)

  /// Redacted (see backend/src/utils/redact.ts) before being persisted
  /// — never store a raw password/token/secret here even transiently.
  beforeState Json? @map("before_state")
  afterState  Json? @map("after_state")

  reason   String? @db.VarChar(1000)
  metadata Json?

  @@index([actorType, actorId])
  @@index([resourceType, resourceId])
  @@index([correlationId])
  @@index([occurredAt])
  @@map("audit_events")
}

enum ActorType {
  USER
  SYSTEM
  SERVICE
  UNKNOWN

  @@map("actor_type")
}

// ============================================================================
// IdempotencyKey — generic, scope-namespaced idempotency ledger.
//
// Owner: platform-wide (Constitution Article I, Server-Authoritative
// State: "Payment success, course/lesson completion, gamification
// point awards, quiz results, and AI-driven decisions are only
// finalized after backend verification (signed webhook,
// idempotency-key check, or explicit rule evaluation)"). Directly
// named as a required mechanic by 006-gamification-rewards FR-014
// ("System MUST require a source event ID, rule ID, user ID, and
// idempotency key on every point-award request, and MUST enforce a
// unique-transaction constraint").
//
// This table is the shared, schema-agnostic MECHANISM — it does not
// know or care what "gamification.point-award" or
// "payment.webhook.stripe" actually do; each owning feature is
// responsible for choosing its own `scope` string and interpreting its
// own `responseSnapshot` shape. No business logic lives here.
// ============================================================================
model IdempotencyKey {
  id String @id @default(uuid()) @db.Uuid

  /// Caller-supplied idempotency key (e.g. a UUID the client generates
  /// once per logical operation and retries with unchanged).
  key String @db.VarChar(191)

  /// Namespaces `key` per feature/use-case so two unrelated features
  /// can never collide on the same key value, e.g.
  /// "gamification.point-award", "payment.webhook.stripe".
  scope String @db.VarChar(191)

  /// Optional hash of the request payload — lets a caller detect the
  /// "same key, different request body" misuse case (a classic
  /// idempotency bug class) rather than silently returning a stale
  /// cached response for a materially different request.
  requestHash String? @map("request_hash") @db.VarChar(64)

  status IdempotencyStatus @default(PENDING)

  /// Cached result to return on a retried request once `status` is
  /// COMPLETED — shape is owned by the calling feature, not this table.
  responseSnapshot Json? @map("response_snapshot")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  /// Idempotency keys are not kept forever — see
  /// docs/database/ARCHITECTURE.md §10 (Data Retention) for the
  /// per-scope expiry policy each feature is expected to configure.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum IdempotencyStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("idempotency_status")
}

// ============================================================================
// Phase 4 — Authentication, Identity & RBAC
//
// Owner: 003-auth-identity-onboarding-dashboard (auth/identity/session
// models) and 001-product-vision-governance (Role/Permission RBAC engine,
// per 001/plan.md's Project Structure `rbac/` module and FR-084–FR-089).
// Scope is deliberately narrower than either spec's full entity list —
// see docs/auth/TRACEABILITY.md for exactly which FRs each model below
// implements and which are explicitly deferred (mobile OTP, Google/Apple
// OAuth, SMS/email 2FA, full profile management, account merge/export).
//
// NOTE on architecture: 001/plan.md and 003/plan.md both describe a
// NestJS backend (`backend/src/modules/...`). The ACTUAL, already-built
// and approved backend (Phases 1–3) is plain Express + TypeScript with a
// Clean Architecture layering (routes/controllers/services/repositories),
// not NestJS. This is a confirmed spec-vs-implementation conflict,
// reported in the Phase 4 final report rather than silently resolved —
// the models/FRs below are implemented against the REAL, already-approved
// Express/Prisma architecture, not the plan.md's NestJS assumption.
// ============================================================================

// ----------------------------------------------------------------------------
// User — the root account record (003 Key Entity "User": "The root account
// record tying a single person to one primary platform identity"; FR-001).
// Combines 001's "User Account" and 003's private-identity fields per
// FR-002 ("store authentication data... as a record separate from the
// user's PUBLIC profile data" — the separation this schema honors is
// User [private] vs UserProfile [public], not a third "Account" model).
// ----------------------------------------------------------------------------
model User {
  id String @id @default(uuid()) @db.Uuid

  /// Lowercase-normalized per FR-017. Unique per FR-001 (exactly one
  /// primary identity per person).
  email           String    @unique @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)

  /// FR-064: account lifecycle status. Scope note: this schema
  /// implements PENDING_VERIFICATION / ACTIVE / LOCKED / SUSPENDED /
  /// DEACTIVATED / DELETED — the 10-state list in FR-064 also names
  /// "onboarding incomplete", "restricted" (sub-flag, not a status), and
  /// "merged", deferred per docs/auth/TRACEABILITY.md (onboarding is
  /// 003 US2, out of Phase 4 scope; account merge FR-131 needs
  /// cross-feature purchase/progress data that doesn't exist yet).
  status AccountStatus @default(PENDING_VERIFICATION)

  /// FR-062/FR-141: failed-login lockout tracking. Full risk-signal
  /// evaluation (impossible travel, malicious IP, new-country — FR-062)
  /// is deferred — see docs/auth/TRACEABILITY.md — this covers only the
  /// repeated-failures signal, which needs no external provider.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)

  /// FR-050: mandatory-2FA gate for privileged roles is evaluated against
  /// this flag by the authorization layer, not stored redundantly per role.
  mfaEnabled Boolean @default(false) @map("mfa_enabled")

  /// Soft-delete / anonymization marker (FR-133). Distinct from `status`:
  /// `status = DELETED` is the user-facing lifecycle state; `deletedAt`
  /// is the technical anonymization timestamp, per
  /// docs/database/ARCHITECTURE.md §9's soft-delete standard.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile            UserProfile?
  credentials        Credential[]
  sessions           Session[]
  roles              UserRole[]
  mfaCredential      MfaCredential?
  recoveryCodes      RecoveryCode[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  loginAttempts      LoginAttempt[]

  /// Phase 6 Part 1 — LMS course-instructor assignments. Deliberately
  /// just a back-relation to CourseInstructor (required by Prisma for
  /// any explicit FK relation), not a new user/profile table — 006 LMS
  /// FR "instructor" is a ROLE + assignment record on top of the
  /// existing User, never a duplicate identity.
  courseInstructorRoles CourseInstructor[]
  /// Phase 6 Part 2 — a learner's course access grants (004 FR-021–033).
  enrollments           Enrollment[]

  /// 001 FR-086: Organization Admin's own-organization scope. Nullable —
  /// most users belong to no organization; set only for Organization-tier
  /// members and their Organization Admin.
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  /// 001 FR-039–FR-046 — lifecycle stage tracker, one row per user, only
  /// from REGISTERED_USER onward (Visitor/Lead precede User existence —
  /// owned by future CRM/marketing features per spec.md Assumptions).
  lifecycleState UserLifecycleState?
  milestones     BusinessMilestone[]
  lifecycleEvents LifecycleEvent[]

  /// 001 FR-090–FR-093 — Trust & Safety: cases this user filed as a
  /// reporter, and cases filed against this user as the moderation subject.
  reportedCases          TrustSafetyCase[] @relation("ReportedCases")
  moderationSubjectCases TrustSafetyCase[] @relation("ModerationSubjectCases")

  /// 003 US2 — the 13-step onboarding sequence and its generated Roadmap.
  onboardingSteps OnboardingStepResponse[]
  roadmap         Roadmap?

  @@index([status])
  @@index([organizationId])
  @@map("users")
}

// ----------------------------------------------------------------------------
// Organization — 001 FR-053/FR-086: the Organization membership tier and
// Organization Admin role's own-org-only data scope. Deliberately minimal
// (name/slug/status only) — this schema's own header note flagged
// Organization as "considered and rejected as premature" prior to this
// feature; 001 is the feature that actually needs it (Organization Admin
// role + Organization membership tier both require a real entity to scope
// against, not just a permission name with nothing behind it).
// ----------------------------------------------------------------------------
model Organization {
  id String @id @default(uuid()) @db.Uuid

  name String @db.VarChar(200)
  slug String @unique @db.VarChar(220)

  status OrganizationStatus @default(ACTIVE)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  members User[]

  @@map("organizations")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("organization_status")
}

// ----------------------------------------------------------------------------
// UserLifecycleState — 001 FR-017 (onboarding capture) + FR-039–FR-046
// (8-stage lifecycle; VISITOR/LEAD precede account creation and are
// out of this feature's scope per spec.md Assumptions — owned by a future
// CRM/marketing feature). One row per User, created at registration.
// ----------------------------------------------------------------------------
model UserLifecycleState {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stage UserLifecycleStage @default(REGISTERED_USER)

  languageSelected String?  @map("language_selected") @db.VarChar(10)
  goalSelected     String?  @map("goal_selected") @db.VarChar(120)
  experienceLevel  String?  @map("experience_level") @db.VarChar(60)
  skillSelected    String?  @map("skill_selected") @db.VarChar(120)
  businessStage    String?  @map("business_stage") @db.VarChar(60)
  timeAvailability String?  @map("time_availability") @db.VarChar(60)
  interests        String[]
  nicheSelected    String?  @map("niche_selected") @db.VarChar(120)

  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(6)

  /// FR-042 Activated Member joint criteria + FR-014 Next-Best-Action
  /// chain. Populated by the owning feature as each milestone occurs
  /// (LMS for the lesson/path timestamps; future Community/AI-workspace
  /// features for the rest — see docs referenced in lifecycle module).
  firstLearningPathStartedAt DateTime? @map("first_learning_path_started_at") @db.Timestamptz(6)
  firstLessonCompletedAt     DateTime? @map("first_lesson_completed_at") @db.Timestamptz(6)
  firstCommunityActionAt     DateTime? @map("first_community_action_at") @db.Timestamptz(6)
  firstOfferCreatedAt        DateTime? @map("first_offer_created_at") @db.Timestamptz(6)
  firstPurchaseAt            DateTime? @map("first_purchase_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([stage])
  @@map("user_lifecycle_states")
}

enum UserLifecycleStage {
  REGISTERED_USER
  ACTIVATED_MEMBER
  ENGAGED_MEMBER
  PAYING_MEMBER
  ACHIEVER
  ADVOCATE

  @@map("user_lifecycle_stage")
}

// ----------------------------------------------------------------------------
// BusinessMilestone — 001 FR-045, Constitution Article VIII: Achiever-stage
// milestones MUST be verified, never auto-marked from a self-reported claim.
// ----------------------------------------------------------------------------
model BusinessMilestone {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   BusinessMilestoneType
  status MilestoneStatus @default(CLAIMED)

  claimedAt      DateTime  @default(now()) @map("claimed_at") @db.Timestamptz(6)
  verifiedAt     DateTime? @map("verified_at") @db.Timestamptz(6)
  verifiedBy     String?   @map("verified_by") @db.Uuid
  rejectedReason String?   @map("rejected_reason") @db.Text

  evidence Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, type])
  @@index([status])
  @@map("business_milestones")
}

enum BusinessMilestoneType {
  FIRST_CLIENT
  FIRST_1000
  FIRST_10000
  FIRST_1_LAKH
  FIRST_COURSE_LAUNCH
  FIRST_100_COMMUNITY_MEMBERS

  @@map("business_milestone_type")
}

enum MilestoneStatus {
  CLAIMED
  VERIFIED
  REJECTED

  @@map("milestone_status")
}

// ----------------------------------------------------------------------------
// LifecycleEvent — 001 FR-043 (Engaged Member weekly-recurring signals)
// and FR-046 (Advocate-stage contributions). An append-only ledger, not a
// mutable counter — lesson-completion signals are read directly from the
// existing LMS LessonProgress table rather than duplicated here.
// ----------------------------------------------------------------------------
model LifecycleEvent {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       LifecycleEventType
  metadata   Json?
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([userId, type, occurredAt])
  @@map("lifecycle_events")
}

enum LifecycleEventType {
  POST_INTERACTION
  EVENT_ATTENDANCE
  CHALLENGE_SUBMISSION
  REFERRAL
  TESTIMONIAL_SUBMISSION
  CASE_STUDY_SUBMISSION
  MENTOR_APPLICATION
  COMMUNITY_LEADERSHIP

  @@map("lifecycle_event_type")
}

// ----------------------------------------------------------------------------
// TrustSafetyCase / Appeal — 001 FR-090–FR-093: report/block/mute enter a
// moderation queue with evidence retention, escalation to a moderation
// action, and an appeal path. `targetId` is a loose string reference (not
// an FK) since the target may be a post/comment/profile from a future
// Community feature (005) that doesn't exist as a table yet — same
// "loose reference by design" pattern already used by `Product.sellerId`.
// ----------------------------------------------------------------------------
model TrustSafetyCase {
  id String @id @default(uuid()) @db.Uuid

  type       TrustSafetyCaseType
  targetType TrustSafetyTargetType @map("target_type")
  targetId   String?                @map("target_id") @db.VarChar(120)

  reporterId String? @map("reporter_id") @db.Uuid
  reporter   User?   @relation("ReportedCases", fields: [reporterId], references: [id], onDelete: SetNull)

  reportedUserId String? @map("reported_user_id") @db.Uuid
  reportedUser   User?   @relation("ModerationSubjectCases", fields: [reportedUserId], references: [id], onDelete: SetNull)

  reason   String @db.Text
  evidence Json?

  status TrustSafetyCaseStatus @default(OPEN)

  actionType   ModerationActionType? @map("action_type")
  actionReason String?               @map("action_reason") @db.Text
  actionedBy   String?               @map("actioned_by") @db.Uuid
  actionedAt   DateTime?             @map("actioned_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  appeals Appeal[]

  @@index([status])
  @@index([reportedUserId])
  @@map("trust_safety_cases")
}

enum TrustSafetyCaseType {
  REPORT
  BLOCK
  MUTE

  @@map("trust_safety_case_type")
}

enum TrustSafetyTargetType {
  POST
  COMMENT
  PROFILE
  USER

  @@map("trust_safety_target_type")
}

enum TrustSafetyCaseStatus {
  OPEN
  UNDER_REVIEW
  ACTION_TAKEN
  DISMISSED

  @@map("trust_safety_case_status")
}

enum ModerationActionType {
  WARNING
  TEMPORARY_SUSPENSION
  PERMANENT_BAN

  @@map("moderation_action_type")
}

model Appeal {
  id     String          @id @default(uuid()) @db.Uuid
  caseId String          @map("case_id") @db.Uuid
  case   TrustSafetyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  submittedBy String @map("submitted_by") @db.Uuid
  statement   String @db.Text

  status AppealStatus @default(PENDING)

  resolvedBy     String?   @map("resolved_by") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolutionNote String?   @map("resolution_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@map("appeals")
}

enum AppealStatus {
  PENDING
  UPHELD
  OVERTURNED

  @@map("appeal_status")
}

// ----------------------------------------------------------------------------
// GovernanceRecord — 001 FR-083: every major feature release passes through
// a fixed 10-stage governance sequence before reaching users.
// ----------------------------------------------------------------------------
model GovernanceRecord {
  id String @id @default(uuid()) @db.Uuid

  featureName String       @map("feature_name") @db.VarChar(200)
  phase       ProductPhase

  currentStage GovernanceStage @default(REQUIREMENT_APPROVAL) @map("current_stage")
  stageHistory Json            @default("[]") @map("stage_history")

  monitoringStartedAt DateTime? @map("monitoring_started_at") @db.Timestamptz(6)
  postReleaseReviewAt DateTime? @map("post_release_review_at") @db.Timestamptz(6)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([phase, currentStage])
  @@map("governance_records")
}

enum ProductPhase {
  FOUNDATION_MVP
  GROWTH_PLATFORM
  BUSINESS_OPERATING_SYSTEM
  ENTERPRISE_ECOSYSTEM

  @@map("product_phase")
}

enum GovernanceStage {
  REQUIREMENT_APPROVAL
  UX_REVIEW
  TECHNICAL_REVIEW
  SECURITY_REVIEW
  DEVELOPMENT
  QA
  UAT
  RELEASE_APPROVAL
  MONITORING
  POST_RELEASE_REVIEW

  @@map("governance_stage")
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
  DEACTIVATED
  DELETED

  @@map("account_status")
}

// ----------------------------------------------------------------------------
// UserProfile — public-facing identity, deliberately separate from `User`
// per FR-002/FR-070 ("private identity fields... separately from public
// profile fields"). Deliberately MINIMAL for Phase 4: only what
// registration needs (display name, optional username slot). The full
// profile-management surface (photo upload, visibility controls, username
// change policy — FR-071–FR-076) is 003/tasks.md's own "Phase D2" —
// explicitly scoped as a supplementary phase there, not part of Phase 4's
// auth/identity/RBAC mandate. See docs/auth/TRACEABILITY.md.
// ----------------------------------------------------------------------------
model UserProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String  @map("display_name") @db.VarChar(120)
  username    String? @unique @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_profiles")
}

// ----------------------------------------------------------------------------
// Credential — one login method linked to a User (FR-001: "multiple login
// methods... can be linked" to one identity; FR-007: architecture ready
// for future providers). Only PASSWORD is implemented in Phase 4 — GOOGLE/
// APPLE/OTP_MOBILE are modeled in the enum for forward-compatibility per
// FR-007 but have no implementation yet (deferred, see
// docs/auth/TRACEABILITY.md).
// ----------------------------------------------------------------------------
model Credential {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type CredentialType

  /// Argon2id hash (FR-138). Only populated for type = PASSWORD. Never
  /// logged, never included in an API response — see
  /// backend/src/auth/password.util.ts.
  passwordHash String? @map("password_hash") @db.VarChar(255)

  /// Reserved for future OAuth providers (FR-007) — the provider's
  /// opaque subject identifier. Unused while only PASSWORD is implemented.
  providerSubject String? @map("provider_subject") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, type])
  @@map("credentials")
}

enum CredentialType {
  PASSWORD
  GOOGLE
  APPLE
  OTP_MOBILE

  @@map("credential_type")
}

// ----------------------------------------------------------------------------
// Session — one authenticated session + its current refresh token (FR-055,
// FR-056). Refresh-token rotation and reuse detection (FR-056, "Refresh
// Tokens and Session Management" §6 of the Phase 4 brief) are implemented
// by rotating `refreshTokenHash`/`refreshTokenFamily` in place rather than
// a separate RefreshToken table — a session's current refresh token IS the
// session's live rotation state; a mismatch against the stored hash on
// presentation is the reuse-detection signal (see
// backend/src/auth/session.service.ts).
// ----------------------------------------------------------------------------
model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Hash of the current valid refresh token for this session — never the
  /// raw token (FR-056, "store token hashes, not raw refresh tokens").
  refreshTokenHash String @unique @map("refresh_token_hash") @db.VarChar(64)

  /// Stable identifier for this session's rotation lineage — every
  /// rotated refresh token shares the same family. Presenting a
  /// non-current hash for a still-active family is the reuse signal that
  /// revokes the entire family (FR-056).
  tokenFamily String @map("token_family") @db.VarChar(64)

  revoked       Boolean   @default(false)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason") @db.VarChar(100)

  /// FR-055: device/session metadata, only where allowed (§6 — no
  /// precise-location tracking without a configured geo-IP provider,
  /// see docs/auth/TRACEABILITY.md).
  deviceName String? @map("device_name") @db.VarChar(255)
  userAgent  String? @map("user_agent") @db.VarChar(512)
  ipAddress  String? @map("ip_address") @db.VarChar(45)

  lastActiveAt DateTime @default(now()) @map("last_active_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, revoked])
  @@index([expiresAt])
  @@map("sessions")
}

// ----------------------------------------------------------------------------
// RBAC — Role / Permission / RolePermission / UserRole. Canonical owner:
// 001-product-vision-governance (FR-084–FR-089; 001/plan.md's `rbac/`
// module). 003 explicitly reuses this rather than redefining it
// (003/spec.md FR-067/FR-068, 003/tasks.md T009). Seeded with exactly the
// 12 roles named in 001 FR-084–FR-086 / 003 FR-067 — "do not invent dozens
// of placeholder permissions" per the Phase 4 brief honored by seeding
// only the baseline permission set documented in
// docs/auth/RBAC_MATRIX.md, not a speculative full catalog.
// ----------------------------------------------------------------------------
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  /// Canonical machine name, e.g. "platform_admin" (FR-084–FR-086).
  name        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id  String @id @default(uuid()) @db.Uuid
  /// Discrete, action-based identifier per 003 FR-068, e.g.
  /// "course.view", "payment.refund", "user.suspend".
  key String @unique @db.VarChar(100)

  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

/// Prevents duplicate role/permission ownership (Phase 4 brief §10) via
/// the @@unique([roleId, permissionId]) constraint below.
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Prevents duplicate role ownership (Phase 4 brief §10) via the
/// @@unique([userId, roleId]) constraint below — a user may hold more
/// than one role (e.g. Paid Member + Mentor), but never the same role twice.
model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  /// FR-130: role changes require a reason and are audited (via the
  /// shared AuditEvent table, not duplicated here).
  assignedBy String?  @map("assigned_by") @db.Uuid
  reason     String?  @db.VarChar(500)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ----------------------------------------------------------------------------
// PasswordResetToken / EmailVerificationToken — single-use, hashed,
// expiring tokens (FR-024–FR-027 verification; FR-043–FR-046 reset).
// Hashed storage per the Phase 4 brief §2 ("store token hashes, not raw
// tokens") — mirrors the pattern already established by Phase 3's
// IdempotencyKey/AuditEvent hashing conventions.
// ----------------------------------------------------------------------------
model PasswordResetToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address") @db.VarChar(45)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

// ----------------------------------------------------------------------------
// MfaCredential / RecoveryCode — TOTP-based 2FA (FR-050–FR-054). Only
// authenticator-app TOTP + recovery codes are implemented — SMS OTP and
// email OTP as 2FA *methods* (FR-051) are deferred pending a configured
// SMS/email provider, per docs/auth/TRACEABILITY.md and the Phase 4
// brief's own "if the specification does not choose a concrete MFA
// method, stop and report" guidance (TOTP is the one method requiring no
// external provider, so it is the one implemented now).
// ----------------------------------------------------------------------------
model MfaCredential {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Encrypted (AES-256-GCM, application-layer) TOTP secret — never
  /// returned after enrollment completes (Phase 4 brief §9).
  encryptedSecret String @map("encrypted_secret") @db.VarChar(255)

  enabled      Boolean   @default(false)
  enabledAt    DateTime? @map("enabled_at") @db.Timestamptz(6)
  /// Replay protection (FR-054/§9): the last successfully-consumed TOTP
  /// step, so the same 30s code cannot be replayed within its own window.
  lastUsedStep BigInt?   @map("last_used_step")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("mfa_credentials")
}

model RecoveryCode {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Hashed (FR-053: "one-time-use, hashed-storage recovery codes").
  codeHash String    @map("code_hash") @db.VarChar(64)
  usedAt   DateTime? @map("used_at") @db.Timestamptz(6)

  /// Regenerating invalidates all previously issued codes (FR-053) —
  /// implemented by generating a new `batchId` and only ever accepting
  /// unused codes from the CURRENT batch.
  batchId String @map("batch_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, batchId])
  @@map("recovery_codes")
}

// ----------------------------------------------------------------------------
// LoginAttempt — operational rate-limiting/lockout data (FR-062 repeated-
// failures signal). Deliberately separate from the immutable AuditEvent
// trail: this is short-lived, prunable operational data used for a
// rolling-window count, not a permanent compliance record (though every
// login success/failure is ALSO recorded in AuditEvent for audit
// purposes — see backend/src/auth/login.service.ts).
// ----------------------------------------------------------------------------
model LoginAttempt {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Kept even when no matching user was found (unknown-email login
  /// attempts still count toward IP-level throttling upstream).
  emailAttempted String  @map("email_attempted") @db.VarChar(255)
  succeeded      Boolean
  ipAddress      String? @map("ip_address") @db.VarChar(45)
  userAgent      String? @map("user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([emailAttempted, createdAt])
  @@map("login_attempts")
}

// ============================================================================
// Phase 5 (Part 1) — Public Website & CMS Foundation
//
// Owner: 002-public-website-marketing-funnel (Page/Block/Navigation/
// Announcement/SEO — FR-001–FR-010, FR-084–FR-092). Scope note: this is
// Part 1 only — the funnel/lead-capture/checkout-tracking/experiment
// entities 002 also owns (Lead, Campaign, Checkout Session, Experiment)
// are deliberately NOT modeled here; see docs/public-site/TRACEABILITY.md
// for the exact scope boundary and docs/public-site/DECISION_GATES.md
// for why each is deferred rather than built now.
//
// `Page` here is distinct from Phase 4's `User`/RBAC models and from
// 001's future `Content Item` (content-governance) entity — 001's
// content-governance module is not implemented in this codebase yet
// (001 has never been code-implemented, only spec-corrected — see
// docs/auth/TRACEABILITY.md §"Architecture conflict" for the identical
// finding already made for 001/003). `Page` does not duplicate anything
// that currently exists in code.
// ============================================================================

// ----------------------------------------------------------------------------
// Page — a CMS-managed public URL (002 FR-086, Key Entity "Page").
// ----------------------------------------------------------------------------
model Page {
  id String @id @default(uuid()) @db.Uuid

  /// URL-safe identifier. Unique per (slug, language) — the same slug may
  /// exist in multiple languages (002 FR-075/FR-076).
  slug     String       @db.VarChar(191)
  language PageLanguage @default(EN)

  template PageTemplate @default(STANDARD)
  status   PageStatus   @default(DRAFT)

  title String @db.VarChar(255)

  // --- SEO fields embedded directly on Page (FR-090), rather than a
  // separate joined SeoMetadata table — every Page always has exactly
  // one SEO configuration, so a 1:1 join table would add a lookup with
  // no modeling benefit. See docs/public-site/CMS_MODEL.md §2. ---
  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.VarChar(500)
  canonicalUrl   String? @map("canonical_url") @db.VarChar(500)
  ogImageUrl     String? @map("og_image_url") @db.VarChar(500)
  noIndex        Boolean @default(false) @map("no_index")

  /// Simple scalar tag list (Postgres native array) — used by blog-
  /// template pages for category/tag taxonomy (FR-049). Deliberately not
  /// a separate Tag/PageTag join-table model: tags here are lightweight,
  /// page-owned labels, not a shared cross-entity taxonomy (which would
  /// only be justified once Courses/Events/Resources also need to share
  /// the same tag vocabulary — none of which exist yet).
  tags String[]

  /// Role names (matching Phase 4's `Role.name`) required to see this
  /// page; empty = visible to everyone. Structurally ready for FR-072's
  /// audience targeting; not yet consulted by any enforcement path since
  /// no frontend auth session exists yet (see
  /// docs/public-site/TRACEABILITY.md FR-007).
  audienceRoles String[] @map("audience_roles")

  headerVisible Boolean @default(true) @map("header_visible")
  footerVisible Boolean @default(true) @map("footer_visible")

  publishAt DateTime? @map("publish_at") @db.Timestamptz(6)
  expireAt  DateTime? @map("expire_at") @db.Timestamptz(6)

  /// FR-105: admin preview links expire — a short-lived token that lets
  /// a non-published page render via `?preview=<token>`. Only the SHA-256
  /// hash is persisted (same hashed-token pattern as PasswordResetToken /
  /// EmailVerificationToken / NewsletterSubscriber.unsubscribeTokenHash) —
  /// the raw token exists only in the generation response and the URL.
  previewTokenHash String?   @unique @map("preview_token_hash") @db.VarChar(64)
  previewExpiresAt DateTime? @map("preview_expires_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  blocks   PageBlock[]
  versions PageVersion[]
  /// 002 US3 — set only for a masterclass/webinar landing page.
  masterclassConfig MasterclassConfig?

  @@unique([slug, language])
  @@index([status, publishAt])
  @@index([template])
  @@map("pages")
}

enum PageLanguage {
  EN
  TA
  TANGLISH

  @@map("page_language")
}

/// FR-087: Draft → Review → Approved → Scheduled → Published → Archived.
enum PageStatus {
  DRAFT
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  /// 001 FR-097: distinct from ARCHIVED — a page taken down but not
  /// permanently retired (e.g. temporarily pulled, can be republished
  /// directly without re-entering the draft/review workflow).
  UNPUBLISHED
  ARCHIVED

  @@map("page_status")
}

/// A small, named set of page "shapes" this part's renderer understands —
/// not a full template engine. HOME/BLOG_POST get dedicated route
/// handling (docs/public-site/TRACEABILITY.md); STANDARD covers every
/// other CMS-driven marketing page (About, Pricing, FAQ, Privacy, Terms,
/// Cookies, Careers, Press, Status, Roadmap, Release Notes).
enum PageTemplate {
  STANDARD
  HOME
  BLOG_POST

  @@map("page_template")
}

// ----------------------------------------------------------------------------
// PageBlock — an ordered content-block instance within a Page (FR-085,
// Key Entity "Page Section / Content Block").
// ----------------------------------------------------------------------------
model PageBlock {
  id     String @id @default(uuid()) @db.Uuid
  pageId String @map("page_id") @db.Uuid
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  type    PageBlockType
  order   Int
  visible Boolean       @default(true)

  /// Block-shape-specific content. Validated at the application layer
  /// per block type (see backend/src/cms/block-schemas.ts) rather than
  /// via a rigid per-type column set — the 20 block types in FR-085 have
  /// genuinely different field shapes, and a JSON column with an
  /// app-layer Zod schema per type avoids either 20 near-empty tables or
  /// one enormous nullable-everything table.
  data Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([pageId, order])
  @@map("page_blocks")
}

/// FR-085's block-type list plus two Phase 5 Part 2 additions (GALLERY,
/// DOWNLOAD) explicitly requested beyond the spec's own list — kept
/// distinct from CUSTOM_HTML rather than folded into it, since each has
/// its own validated, non-arbitrary-HTML data shape. PROGRAMS/COURSES/
/// EVENTS/MENTORS/CUSTOM_HTML are modeled (so a future page can
/// reference them) but render an explicit placeholder today — see
/// docs/public-site/DECISION_GATES.md.
enum PageBlockType {
  HERO
  TEXT
  IMAGE
  GALLERY
  VIDEO
  CTA
  FEATURES
  STATS
  TESTIMONIALS
  PRICING
  FAQ
  TIMELINE
  TEAM
  LOGO_STRIP
  PROGRAMS
  COURSES
  EVENTS
  MENTORS
  FORM
  DOWNLOAD
  CUSTOM_HTML
  SPACER
  DIVIDER

  @@map("page_block_type")
}

// ----------------------------------------------------------------------------
// PageVersion — non-destructive version history (FR-088). A full JSON
// snapshot of the page's settings + blocks is written on every publish-
// affecting update, never overwritten — mirrors the non-destructive
// principle Constitution Article IV already establishes platform-wide
// (and the exact pattern 001/plan.md describes for its own Content
// Version service, applied here to Page directly since 001's module
// isn't implemented in code yet — see this file's header note).
// ----------------------------------------------------------------------------
model PageVersion {
  id     String @id @default(uuid()) @db.Uuid
  pageId String @map("page_id") @db.Uuid
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  versionNumber Int  @map("version_number")
  snapshot      Json

  editedBy String? @map("edited_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([pageId, versionNumber])
  @@map("page_versions")
}

// ----------------------------------------------------------------------------
// NavigationItem — header/footer/mobile menu tree (FR-001–FR-003, FR-008,
// Key Entity "Navigation"). Self-referencing for mega-menu/dropdown
// sub-items (FR-002) — never hardcoded in frontend code, per the brief's
// explicit "Do not hardcode menu items."
// ----------------------------------------------------------------------------
model NavigationItem {
  id String @id @default(uuid()) @db.Uuid

  location NavLocation

  parentId String?          @map("parent_id") @db.Uuid
  parent   NavigationItem?  @relation("NavigationItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavigationItemChildren")

  label      String  @db.VarChar(100)
  url        String  @db.VarChar(500)
  isExternal Boolean @default(false) @map("is_external")

  /// Structurally ready for FR-007's permission-aware nav items; not yet
  /// consulted (no frontend auth session — see Page.audienceRoles' note).
  requiredPermission String? @map("required_permission") @db.VarChar(100)

  /// Groups top-level dropdown children into mega-menu columns (FR-002).
  megaMenuColumn String? @map("mega_menu_column") @db.VarChar(100)

  order   Int
  visible Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([location, parentId, order])
  @@map("navigation_items")
}

enum NavLocation {
  HEADER
  FOOTER
  MOBILE

  @@map("nav_location")
}

// ----------------------------------------------------------------------------
// Announcement — time-boxed, prioritized, dismissible site-wide banner
// (FR-005, FR-006, Key Entity "Announcement").
// ----------------------------------------------------------------------------
model Announcement {
  id String @id @default(uuid()) @db.Uuid

  text        String  @db.VarChar(500)
  icon        String? @db.VarChar(50)
  ctaLabel    String? @map("cta_label") @db.VarChar(100)
  ctaUrl      String? @map("cta_url") @db.VarChar(500)
  style       String  @default("info") @db.VarChar(20)
  dismissible Boolean @default(true)
  priority    Int     @default(0)

  audienceRoles String[] @map("audience_roles")

  startDate DateTime @map("start_date") @db.Timestamptz(6)
  endDate   DateTime @map("end_date") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([startDate, endDate, priority])
  @@map("announcements")
}

// ----------------------------------------------------------------------------
// Redirect — URL-to-URL mapping for SEO/broken-link management (FR-092,
// Key Entity "Redirect").
// ----------------------------------------------------------------------------
model Redirect {
  id String @id @default(uuid()) @db.Uuid

  fromPath   String @unique @map("from_path") @db.VarChar(500)
  toPath     String @map("to_path") @db.VarChar(500)
  statusCode Int    @default(301) @map("status_code")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("redirects")
}

// ----------------------------------------------------------------------------
// FaqEntry — categorized, searchable FAQ (002 FR-028, FR-091's FAQ
// structured-data type, Key Entity "FAQ").
// ----------------------------------------------------------------------------
model FaqEntry {
  id String @id @default(uuid()) @db.Uuid

  category String @db.VarChar(100)
  question String @db.VarChar(500)
  answer   String

  order   Int     @default(0)
  visible Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([category, order])
  @@map("faq_entries")
}

// ----------------------------------------------------------------------------
// ConsentRecord — per-channel, versioned consent (FR-101, FR-102,
// Constitution Article VI). Generic across every consent-capturing
// surface this part builds (Contact form, Newsletter signup, cookie
// banner) — never a single combined opt-in flag, per the constitution's
// explicit requirement.
// ----------------------------------------------------------------------------
model ConsentRecord {
  id String @id @default(uuid()) @db.Uuid

  /// Nullable — a consent record may belong to an authenticated User
  /// (Phase 4) or to an anonymous lead identified only by email (this
  /// part has no Lead entity — see docs/public-site/DECISION_GATES.md;
  /// email is the identifying key for pre-account consent).
  userId String? @map("user_id") @db.Uuid
  email  String? @db.VarChar(255)

  channel       ConsentChannel
  policyVersion String         @map("policy_version") @db.VarChar(20)
  source        String         @db.VarChar(100)
  ipAddress     String?        @map("ip_address") @db.VarChar(45)

  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(6)

  @@index([userId, channel])
  @@index([email, channel])
  @@map("consent_records")
}

enum ConsentChannel {
  TERMS
  PRIVACY
  MARKETING_EMAIL
  WHATSAPP
  SMS
  PARTNER_COMMUNICATION
  PERSONALIZATION_COOKIES

  @@map("consent_channel")
}

// ----------------------------------------------------------------------------
// ContactSubmission — Contact page form (FR-053). Deliberately minimal —
// NOT a full CRM ticket (owner/SLA/queue) since 013-CRM is not built;
// see docs/public-site/DECISION_GATES.md for the migration path once it is.
// ----------------------------------------------------------------------------
model ContactSubmission {
  id String @id @default(uuid()) @db.Uuid

  name       String            @db.VarChar(120)
  email      String            @db.VarChar(255)
  phone      String?           @db.VarChar(30)
  department ContactDepartment
  message    String

  ipAddress String? @map("ip_address") @db.VarChar(45)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("contact_submissions")
}

enum ContactDepartment {
  GENERAL_ENQUIRY
  MEMBERSHIP
  COURSE
  PAYMENT
  PARTNERSHIP
  CORPORATE_TRAINING
  MEDIA
  TECHNICAL_SUPPORT

  @@map("contact_department")
}

// ----------------------------------------------------------------------------
// NewsletterSubscriber — footer/blog newsletter capture (page list's
// "Newsletter" item; FR-008's footer newsletter signup).
// ----------------------------------------------------------------------------
model NewsletterSubscriber {
  id String @id @default(uuid()) @db.Uuid

  email          String    @unique @db.VarChar(255)
  subscribedAt   DateTime  @default(now()) @map("subscribed_at") @db.Timestamptz(6)
  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz(6)

  /// Phase 5 Part 2 — safe unsubscribe strategy: a per-subscriber,
  /// cryptographically random, hashed token (same
  /// generate-raw/store-hash pattern as Phase 4's password-reset and
  /// email-verification tokens) included in every newsletter email's
  /// unsubscribe link. Deliberately NOT email-address-based — an
  /// unsubscribe link keyed only by email would let anyone unsubscribe
  /// anyone else who they merely know the email address of.
  unsubscribeTokenHash String @unique @map("unsubscribe_token_hash") @db.VarChar(64)

  @@map("newsletter_subscribers")
}

// ============================================================================
// Phase 6 Part 1 — Learning Management System: data architecture, course
// engine, categories, modules, instructor assignment.
//
// Owner: 004-lms-courses-learning-paths (Volume 04). Scope: ONLY the course
// authoring/discovery foundation — CourseCategory, Course, CourseModule,
// CourseInstructor, and the course publish lifecycle. Lesson content, video/
// PDF delivery, enrollment, progress, quizzes, assignments, certificates,
// and reviews are explicitly Part 2/Part 3 (see docs/lms/TRACEABILITY_PART1.md
// and docs/lms/DECISION_GATES.md) and are NOT modeled here — no placeholder
// tables for them exist; a future part adds its own models with FKs back to
// Course/CourseModule as needed.
//
// Architecture: builds on the same Express + Prisma + Zod + AppError +
// deny-by-default-RBAC + AuditEvent foundation as Phases 3–5 — no second
// ORM, validation framework, auth system, or API-response shape. See
// docs/lms/ARCHITECTURE.md's "Architecture conflict" note re: 004/plan.md's
// own NestJS assumption (same accepted-decision-gate pattern as Phases 4–5).
// ============================================================================

// ----------------------------------------------------------------------------
// CourseCategory — optional self-referencing hierarchy for course browsing/
// discovery. Archive, never hard-delete, once referenced by a course (a
// hard delete would either orphan Course.categoryId or require a cascading
// delete of courses, both unacceptable).
// ----------------------------------------------------------------------------
model CourseCategory {
  id String @id @default(uuid()) @db.Uuid

  name             String  @db.VarChar(120)
  slug             String  @unique @db.VarChar(160)
  description      String? @db.Text
  shortDescription String? @map("short_description") @db.VarChar(300)
  imageUrl         String? @map("image_url") @db.VarChar(500)
  icon             String? @db.VarChar(60)

  parentId String?          @map("parent_id") @db.Uuid
  parent   CourseCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children CourseCategory[] @relation("CategoryHierarchy")

  /// Stable sibling ordering (admin-controlled, reorder API). Not globally
  /// unique — only meaningful relative to siblings sharing the same parent.
  sortOrder Int @default(0) @map("sort_order")

  status     CategoryStatus @default(ACTIVE)
  isFeatured Boolean        @default(false) @map("is_featured")

  /// Small free-form extension bag (e.g. display accent color) — same
  /// pattern as Page's use of Json for genuinely optional, non-queried
  /// extras. Size-bounded at the application/validation layer, not by
  /// Postgres (see lms.validation.ts).
  metadata Json?

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  courses Course[]

  @@index([parentId])
  @@index([status, sortOrder])
  @@map("course_categories")
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED

  @@map("course_category_status")
}

// ----------------------------------------------------------------------------
// Course — the primary LMS authoring entity (004 FR-014).
//
// Phase 6 Part 1 CORRECTION (spec-alignment pass): the status enum and
// field set below were rebuilt directly from 004/spec.md FR-014/FR-015/
// FR-100 — see docs/lms/COURSE_LIFECYCLE.md for the full reconciliation of
// FR-015's 12 editorial statuses against FR-100's 6-state review workflow,
// and docs/lms/DECISION_GATES.md for why `UNPUBLISHED` (a generic-prompt
// invention with no basis in FR-015 or FR-100) was removed, and why the
// separate `CourseVisibility` enum was removed (FR-015 already models
// "Unlisted" as a `status` value, not a second dimension — keeping both
// would have been exactly the duplicate-canonical-shape problem this
// project's own cross-feature audits repeatedly flag elsewhere).
// ----------------------------------------------------------------------------
model Course {
  id String @id @default(uuid()) @db.Uuid

  title            String  @db.VarChar(200)
  slug             String  @unique @db.VarChar(220)
  subtitle         String? @db.VarChar(300)
  shortDescription String? @map("short_description") @db.VarChar(300)

  /// Rich-text course description. Sanitized at RENDER time by the
  /// existing `frontend/src/utils/sanitizeHtml.ts` (DOMPurify allowlist) —
  /// the same accepted pattern the CMS TEXT block already uses (Phase 5
  /// Part 2 SECURITY.md), not a second, backend-side sanitizer. See
  /// docs/lms/SECURITY.md.
  description String? @db.Text

  /// FR-014 "learning outcomes" — action-based outcome statements (e.g.
  /// "create a 30-day content plan"), plural and structured as a scalar
  /// array (same pattern as `tags` below), not a separate join table —
  /// no second content type needs to share this vocabulary.
  learningOutcomes String[] @map("learning_outcomes")

  /// FR-014 "tags" — same lightweight, page-owned scalar-array pattern
  /// `Page.tags` already established (docs/public-site/CMS_MODEL.md §2).
  tags String[]

  /// FR-014 "target audience" / "tools required" — short descriptive
  /// catalog copy, not structured/queryable data per the source PRD (no
  /// FR describes filtering or matching logic against these fields).
  targetAudience String?  @map("target_audience") @db.Text
  toolsRequired  String[] @map("tools_required")

  thumbnailUrl  String? @map("thumbnail_url") @db.VarChar(500)
  coverImageUrl String? @map("cover_image_url") @db.VarChar(500)
  trailerUrl    String? @map("trailer_url") @db.VarChar(500)

  /// Reuses the CMS `PageLanguage` enum (EN/TA/TANGLISH) rather than a
  /// second, competing language enum — same three-value platform-wide
  /// language set, no LMS-specific values needed.
  language PageLanguage @default(EN)
  level    CourseLevel  @default(ALL_LEVELS)

  status CourseStatus @default(DRAFT)

  categoryId String?         @map("category_id") @db.Uuid
  category   CourseCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  durationMinutes            Int? @map("duration_minutes")
  estimatedCompletionMinutes Int? @map("estimated_completion_minutes")
  weeklyCommitmentMinutes    Int? @map("weekly_commitment_minutes")

  /// FR-014 "certificate availability" — a catalog-level flag ("will this
  /// course offer a certificate") only. Certificate TEMPLATE/ISSUANCE/
  /// VERIFICATION (FR-080–FR-086) is explicitly Phase 6 Part 3 — this flag
  /// exists so Part 1's course-builder metadata is complete without
  /// building any certificate mechanics.
  certificateAvailable Boolean @default(false) @map("certificate_available")
  /// 004 US5 (Certificate System batch) — FR-084 "course mapping": which
  /// template a generated certificate for THIS course uses. Null = no
  /// template configured yet (certificate generation is still allowed —
  /// see certificate.service.ts — just rendered without template styling).
  certificateTemplateId String?              @map("certificate_template_id") @db.Uuid
  certificateTemplate   CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id], onDelete: SetNull)

  priceType        CoursePriceType @default(FREE) @map("price_type")
  /// Money-safe integer minor-unit storage (e.g. paise for INR) — NEVER a
  /// float. No payment processing is implemented here; this is catalog-
  /// level metadata only (004/spec.md Assumptions: Volume 09 is system of
  /// record for payment/membership state), read by a future
  /// 009-membership-payments feature. No entitlement/access-grant
  /// mechanics (FR-021–FR-033) are implemented here — that is Part 2.
  priceAmountMinor Int             @default(0) @map("price_amount_minor")
  currency         String          @default("INR") @db.VarChar(3)

  isFeatured      Boolean @default(false) @map("is_featured")
  enrollmentLimit Int?    @map("enrollment_limit")

  enrollmentStartAt DateTime? @map("enrollment_start_at") @db.Timestamptz(6)
  enrollmentEndAt   DateTime? @map("enrollment_end_at") @db.Timestamptz(6)

  publishAt DateTime? @map("publish_at") @db.Timestamptz(6)
  expireAt  DateTime? @map("expire_at") @db.Timestamptz(6)

  // --- SEO fields, same embedded-on-entity pattern as Page (no separate
  // SeoMetadata join table — see docs/public-site/CMS_MODEL.md §2). ---
  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.VarChar(500)
  canonicalUrl   String? @map("canonical_url") @db.VarChar(500)

  /// FR-100 "Changes requested" reviewer feedback — free text explaining
  /// what must change before resubmission. Cleared on every resubmission
  /// (DRAFT/SUBMITTED_FOR_REVIEW re-entry), never accumulated as history
  /// (full history lives in AuditEvent's beforeState/afterState instead).
  reviewNotes String? @map("review_notes") @db.Text

  /// FR-014 "rating", "review count", "learner count" — nullable/zero-
  /// defaulted PLACEHOLDER aggregate fields. NEVER written to by Part 1
  /// code (no Review/Enrollment model exists to compute them from) —
  /// present only so the Course entity's field set is complete per
  /// FR-014 and so Part 2 (learnerCount, from Enrollment) / Part 3
  /// (ratingAverage/ratingCount, from Course Review) have a column to
  /// populate rather than needing a later migration. Never fabricated;
  /// see docs/lms/DECISION_GATES.md.
  ratingAverage Float? @map("rating_average")
  ratingCount   Int    @default(0) @map("rating_count")
  learnerCount  Int    @default(0) @map("learner_count")

  metadata Json?

  /// Optimistic-concurrency guard for the admin/instructor edit surface —
  /// incremented on every update; a future edit UI can send back the
  /// version it last read and detect a concurrent-edit conflict. Not yet
  /// enforced at the service layer in Part 1 (no concurrent-edit UI
  /// exists yet) — see docs/lms/DECISION_GATES.md.
  version Int @default(1)

  /// FR-014 "created-by, reviewed-by, published-by" — three distinct
  /// actor references, matching FR-100's Author/Reviewer/Publisher role
  /// separation at the DATA level (RBAC still gates who may occupy each
  /// role via the existing `course.*` permissions — see docs/lms/RBAC.md
  /// for why this does not introduce 4 new granular roles).
  createdBy   String? @map("created_by") @db.Uuid
  updatedBy   String? @map("updated_by") @db.Uuid
  reviewedBy  String? @map("reviewed_by") @db.Uuid
  publishedBy String? @map("published_by") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)

  modules     CourseModule[]
  instructors CourseInstructor[]
  /// Phase 6 Part 2 (004 FR-021–033).
  enrollments Enrollment[]
  /// 001 FR-099, Constitution Article IV — closes the gap the schema's own
  /// `version` counter comment flagged ("optimistic-concurrency guard...
  /// not yet enforced"): a non-destructive snapshot is now taken whenever
  /// previously-published course content is edited (see course-version.service.ts).
  versions    CourseVersion[]
  /// 004 US5 (Certificate System batch).
  certificates Certificate[]

  @@index([status])
  @@index([categoryId])
  @@index([status, publishAt])
  @@index([isFeatured])
  @@map("courses")
}

// ----------------------------------------------------------------------------
// CourseVersion — 001 FR-099: "when published course content is changed,
// the system MUST preserve the previous version in an audit log rather
// than overwriting it destructively." Mirrors PageVersion's snapshot
// pattern (full JSON snapshot per edit, append-only, never overwritten).
// ----------------------------------------------------------------------------
model CourseVersion {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @map("course_id") @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  versionNumber Int  @map("version_number")
  snapshot      Json

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([courseId, versionNumber])
  @@index([courseId])
  @@map("course_versions")
}

/// FR-015's 12 editorial statuses reconciled with FR-100's 6-state review
/// workflow (see docs/lms/COURSE_LIFECYCLE.md for the full mapping):
/// FR-100 supplies the enforced WORKFLOW transitions (Draft → Submitted
/// for review → Changes requested → Approved → Scheduled → Published);
/// FR-015 supplies the additional TERMINAL/OPERATIONAL states with their
/// own explicitly-defined per-status access behavior (Unlisted,
/// Enrollment paused, Archived, Retired) that FR-100's narrower workflow
/// view doesn't mention but the SAME feature's own FR-014 field list
/// ("publication status") clearly intends as the same field. FR-015's
/// four editorial sub-review-stage names (Content creation / Internal
/// review / Instructor review / QA review) are treated as PROCESS
/// GUIDANCE within the single `SUBMITTED_FOR_REVIEW` state rather than 4
/// separate enum values — FR-100 (the more implementation-ready of the
/// two FRs, with explicit role/audit requirements) does not name them as
/// distinct states either.
enum CourseStatus {
  DRAFT
  SUBMITTED_FOR_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHED
  /// FR-015: "accessible only via direct link or explicit assignment" —
  /// reachable by slug, excluded from public listing/search/sitemap.
  UNLISTED
  /// FR-015: course remains visible/informational but is not accepting
  /// new enrollment (no Enrollment model exists yet in Part 1 to actually
  /// enforce an enrollment block — this is the catalog-level status flag
  /// FR-014/FR-015 describe; Part 2's Enrollment service is what will
  /// actually consult it).
  ENROLLMENT_PAUSED
  /// FR-015: "preserves existing learner progress while blocking new
  /// enrollment." Part 1 has no learner/progress concept yet, so Archived
  /// courses are hidden from ALL public routes for now (a documented,
  /// intentional Part 1 simplification — see docs/lms/DECISION_GATES.md);
  /// once Part 2's Enrollment exists, Archived detail access can be
  /// scoped to already-enrolled learners specifically.
  ARCHIVED
  /// FR-015: "marks the course replaced or permanently unavailable" — a
  /// true terminal state (see course-lifecycle.policy.ts; no transition
  /// out of RETIRED is permitted).
  RETIRED

  @@map("course_status")
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS

  @@map("course_level")
}

enum CoursePriceType {
  FREE
  PAID

  @@map("course_price_type")
}

// ----------------------------------------------------------------------------
// CourseModule — ordered top-level content grouping within a Course
// (004 FR-016). Deliberately NO lesson/content model here (Part 2 owns
// Lesson) — a module in Part 1 is a named, ordered "chapter" shell with
// CONFIGURATION only. Archive, never hard-delete: a future Lesson FK to
// CourseModule must never be silently orphaned by this phase's own module
// lifecycle.
//
// Part 1 CORRECTION: `releaseRuleType`/`completionRuleType` below are
// CONFIGURATION fields an instructor sets while authoring — Part 1 stores
// the instructor's intent but does NOT evaluate or enforce it (no
// Lesson/Enrollment/drip-release engine exists yet to act on it). No
// public API path in Part 1 changes behavior based on these fields — see
// docs/lms/COURSE_LIFECYCLE.md "Configuration vs. enforcement" section.
// ----------------------------------------------------------------------------
model CourseModule {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @map("course_id") @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String  @db.VarChar(200)
  description String? @db.Text
  /// FR-016 "outcome" — a single learning-outcome statement for this module.
  outcome     String? @db.Text

  /// Stable ordering within the course. Unique per (courseId, position) —
  /// reordering is a single transactional rewrite of every affected row's
  /// position (see module.service.ts's `reorderModules`), never a partial
  /// update that could leave two modules sharing a position.
  position Int

  /// FR-016 "estimated duration" — module-level rollup estimate, entered
  /// directly by the instructor in Part 1 (no Lesson durations exist yet
  /// to sum).
  estimatedDurationMinutes Int? @map("estimated_duration_minutes")

  /// FR-016 "optional/mandatory status" — whether this module blocks
  /// overall course completion once Part 2's completion engine exists.
  isMandatory Boolean @default(true) @map("is_mandatory")

  /// FR-016 "prerequisite module" — self-relation, same course only (a
  /// cross-course prerequisite is explicitly rejected, see
  /// module.service.ts). Nullable = no prerequisite. Cycle-prevented the
  /// same way CourseCategory's parent hierarchy is (module.service.ts's
  /// `assertNoModulePrerequisiteCycle`).
  prerequisiteModuleId String?        @map("prerequisite_module_id") @db.Uuid
  prerequisiteModule   CourseModule?  @relation("ModulePrerequisite", fields: [prerequisiteModuleId], references: [id], onDelete: SetNull)
  dependentModules     CourseModule[] @relation("ModulePrerequisite")

  /// FR-034 release-rule TYPE (config only — see model doc comment).
  /// Values chosen from FR-034's list are the ones meaningful without a
  /// Cohort entity (not built): IMMEDIATE, DAYS_AFTER_ENROLLMENT,
  /// FIXED_DATE, AFTER_PREVIOUS_MODULE, INSTRUCTOR_RELEASE.
  releaseRuleType    ModuleReleaseRuleType @default(IMMEDIATE) @map("release_rule_type")
  /// The type-dependent value (e.g. `{"days": 7}` for
  /// DAYS_AFTER_ENROLLMENT, `{"date": "2026-01-01T00:00:00Z"}` for
  /// FIXED_DATE) — same "enum type + Json value" pattern
  /// `backend/src/cms/block-schemas.ts` already established for
  /// per-type-shaped configuration, not a free-form metadata substitute.
  releaseRuleValue   Json?                 @map("release_rule_value")
  /// Phase 6 Part 2 ADDITIVE field: the timestamp an instructor/admin
  /// manually released this module for a releaseRuleType=INSTRUCTOR_RELEASE
  /// module (004 FR-034). Course-WIDE, not per-enrollment — FR-034 describes
  /// "instructor release" as the instructor unlocking the module for
  /// everyone, not a per-learner grant (that per-learner case is what
  /// CompletionOverride/admin enrollment actions already cover elsewhere).
  /// Null = not yet manually released.
  manuallyReleasedAt DateTime?             @map("manually_released_at") @db.Timestamptz(6)

  /// FR-052 completion-rule TYPE (config only). Only the two values that
  /// are meaningful without Lesson/Quiz/Assignment data are modeled in
  /// Part 1: MANUAL and INSTRUCTOR_APPROVAL. The remaining FR-052 types
  /// (minimum watch, read threshold, quiz pass, assignment submit, etc.)
  /// are meaningless before Part 2's Lesson model exists and are
  /// deliberately NOT modeled here as placeholder enum values.
  completionRuleType ModuleCompletionRuleType @default(MANUAL) @map("completion_rule_type")

  status    CourseModuleStatus @default(DRAFT)
  isPreview Boolean            @default(false) @map("is_preview")

  metadata Json?

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Phase 6 Part 2 (004 FR-017–018) — this module's ordered Lessons.
  lessons Lesson[]

  @@unique([courseId, position])
  @@index([courseId, status])
  @@index([prerequisiteModuleId])
  @@map("course_modules")
}

enum CourseModuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("course_module_status")
}

enum ModuleReleaseRuleType {
  IMMEDIATE
  DAYS_AFTER_ENROLLMENT
  FIXED_DATE
  AFTER_PREVIOUS_MODULE
  INSTRUCTOR_RELEASE

  @@map("module_release_rule_type")
}

enum ModuleCompletionRuleType {
  MANUAL
  INSTRUCTOR_APPROVAL

  @@map("module_completion_rule_type")
}

// ----------------------------------------------------------------------------
// CourseInstructor — assigns an existing User (holding the `course_instructor`
// role, or an admin role) to a Course. NOT a new identity/profile table —
// `user` points directly at the existing Phase-4 User. "Exactly one primary
// instructor per course" is enforced at TWO layers: the service layer
// (transactional check-then-set) AND a partial unique index in this
// migration's raw SQL (`course_instructors_one_primary_per_course`) — Prisma
// has no `@@unique(... WHERE ...)` syntax, so the DB-level guarantee is
// hand-added to the generated migration (see docs/lms/DATA_MODEL.md).
// ----------------------------------------------------------------------------
model CourseInstructor {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @map("course_id") @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  role      InstructorCourseRole @default(INSTRUCTOR)
  isPrimary Boolean              @default(false) @map("is_primary")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([courseId, userId])
  @@index([userId])
  @@index([courseId, isPrimary])
  @@map("course_instructors")
}

enum InstructorCourseRole {
  INSTRUCTOR
  TEACHING_ASSISTANT

  @@map("instructor_course_role")
}

// =============================================================================
// Phase 6 Part 2 — Lessons, Learning Activities, Enrollment, Progress
// (004 FR-017–060). Additive to Part 1's Course/CourseModule — no Part 1
// table/column is altered by this section (only CourseModule gained the
// small additive `manuallyReleasedAt` field and a `lessons` back-relation
// above). See docs/lms/LESSON_ARCHITECTURE.md, ENROLLMENT_LIFECYCLE.md,
// PROGRESS_ENGINE.md for the full design rationale.
// =============================================================================

/// FR-017/FR-018 — the individual learning unit inside a Module. Deliberately
/// carries NO `type` field of its own (per Part 2's explicit Lesson field
/// list, which omits "type") — each attached LearningActivity carries its
/// own `type`, avoiding two competing sources of content-type truth. A
/// Lesson with zero activities is a valid (if unusual) intermediate authoring
/// state; publish-readiness is enforced at the service layer, not the schema.
model Lesson {
  id       String       @id @default(uuid()) @db.Uuid
  moduleId String       @map("module_id") @db.Uuid
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title       String  @db.VarChar(200)
  slug        String  @db.VarChar(220)
  summary     String? @db.VarChar(500)
  description String? @db.Text

  /// Stable ordering within the module — unique per (moduleId, position),
  /// reordered via the same two-pass offset-then-final-position transactional
  /// rewrite `module.repository.ts`'s `reorderModulePositions` established
  /// (see `lesson.repository.ts`'s `reorderLessonPositions`).
  position Int

  durationMinutes Int?    @map("duration_minutes")
  /// FR-018 "preview status" — viewable without enrollment/entitlement
  /// (e.g. a free sample lesson). Preview access is READ-ONLY content
  /// exposure; it never grants progress/completion — see
  /// docs/lms/ACCESS_DECISION_ENGINE.md "Preview is not an entitlement."
  isPreview       Boolean @default(false) @map("is_preview")
  /// FR-018 "mandatory status" — whether this lesson blocks its module's
  /// (and therefore the course's) completion once all mandatory lessons
  /// must be complete. Optional lessons never block completion (FR-054).
  isMandatory     Boolean @default(true) @map("is_mandatory")

  /// FR-052 lesson-level completion-rule TYPE (config only, same
  /// "instructor sets intent, engine enforces it" split Part 1 established
  /// for CourseModule.releaseRuleType/completionRuleType). Only the subset
  /// meaningful without Quiz/Assignment data (Part 3) is modeled:
  /// MANUAL (learner marks complete), MINIMUM_WATCH_PERCENT (video/audio
  /// activity watch threshold), ALL_ACTIVITIES_VIEWED (every attached
  /// LearningActivity must be viewed), INSTRUCTOR_APPROVAL.
  completionRuleType  LessonCompletionRuleType   @default(MANUAL) @map("completion_rule_type")
  /// Type-dependent value, e.g. `{"minPercent": 80}` for
  /// MINIMUM_WATCH_PERCENT — FR-041's "[NEEDS CLARIFICATION]" default is
  /// resolved here as instructor-configurable per lesson rather than a
  /// silently invented global default (see docs/lms/DECISION_GATES.md).
  completionRuleValue Json?                      @map("completion_rule_value")
  /// CORRECTION (Part 2 correction pass): FR-052 explicitly states "MUST
  /// allow a single lesson to combine multiple required conditions" — the
  /// original Part 2 design only ever stored ONE `completionRuleType`,
  /// which could not express that. ADDITIVE fix: when non-empty, this
  /// array is the authoritative set of conditions that must ALL be
  /// satisfied (AND) before the lesson can complete; `completionRuleType`
  /// (singular, above) is kept UNCHANGED for backward compatibility and is
  /// used as a single-element fallback when this array is empty — see
  /// `completion.service.ts`'s `getEffectiveCompletionRules()`. No
  /// existing data is altered by this column's addition.
  completionRuleTypes LessonCompletionRuleType[] @default([]) @map("completion_rule_types")

  status CourseModuleStatus @default(DRAFT)

  version   Int     @default(1)
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  /// Soft delete only (Part 2A brief) — a Lesson is never hard-deleted so a
  /// LessonProgress/CompletionOverride historical record is never orphaned.
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  activities LearningActivity[]
  progress   LessonProgress[]
  /// 004 US3 — a lesson MAY have exactly one attached Quiz (mirrors FR-017
  /// listing "Quiz"/"Assessment" as lesson types); a lesson with no Quiz
  /// row is a plain content lesson, same as before this addition.
  quiz       Quiz?
  /// 004 US4 (Assignment System batch) — same 1:1 pattern as `quiz` above.
  assignment Assignment?

  @@unique([moduleId, slug])
  @@unique([moduleId, position])
  @@index([moduleId, status])
  @@map("lessons")
}

enum LessonCompletionRuleType {
  MANUAL
  MINIMUM_WATCH_PERCENT
  ALL_ACTIVITIES_VIEWED
  INSTRUCTOR_APPROVAL
  /// 004 US3 (Quiz System batch) — satisfied once the enrollment has a
  /// GRADED, passed `QuizAttempt` for this lesson's attached `Quiz`. See
  /// `completion.service.ts`'s `evaluateAutomaticRules`.
  QUIZ_PASS
  /// 004 US4 (Assignment System batch) — satisfied once the enrollment has
  /// an APPROVED `Submission` for this lesson's attached `Assignment`.
  ASSIGNMENT_APPROVED

  @@map("lesson_completion_rule_type")
}

/// FR-017 Lesson Types, narrowed to the subset meaningful as metadata-only
/// content (no runtime playback/streaming/viewer engine is built here —
/// Part 2A brief: "LearningActivity is METADATA only"). Quiz/Assessment/
/// Assignment/Project/Survey/Live-session/SCORM/Interactive-tool/
/// AI-exercise types are explicitly OUT of scope (owned by later phases /
/// Part 3) and deliberately not modeled as placeholder enum values.
enum LearningActivityType {
  VIDEO
  AUDIO
  ARTICLE
  PDF
  DOWNLOAD
  EXTERNAL_LINK
  EMBED

  @@map("learning_activity_type")
}

/// FR-018's "content source" — one ordered content item within a Lesson.
/// Typed, per-type nullable columns (per Part 2A's explicit "avoid JSON
/// blobs when dedicated fields exist" instruction) rather than one big
/// `data Json` blob. Security note (Part 2C content-type review): EMBED
/// stores a typed `embedProvider` + `embedResourceId` pair, NEVER raw
/// iframe/HTML — see `activity.validation.ts` for the provider allowlist
/// and `docs/lms/LEARNING_ACTIVITIES.md` "Per-content-type security rules."
model LearningActivity {
  id       String @id @default(uuid()) @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  type  LearningActivityType
  title String?              @db.VarChar(200)

  /// Ordering within the lesson — unique per (lessonId, position).
  position Int

  /// VIDEO/AUDIO/DOWNLOAD/PDF — a safe-scheme-only (https:// or a signed
  /// internal storage reference), typed URL. Never raw HTML.
  mediaUrl        String? @map("media_url") @db.VarChar(500)
  /// EXTERNAL_LINK — safe-scheme-only URL, opened as a plain link, never
  /// rendered as an embed.
  externalUrl     String? @map("external_url") @db.VarChar(500)
  /// ARTICLE — plain/sanitized text body (rendered as text, not raw HTML —
  /// same rich-text-vs-raw-HTML discipline as the CMS block-schemas model).
  bodyText        String? @map("body_text") @db.Text
  /// VIDEO/AUDIO — used by MINIMUM_WATCH_PERCENT completion evaluation.
  durationSeconds Int?    @map("duration_seconds")
  /// DOWNLOAD/PDF — metadata only, no virus-scanning/upload pipeline built
  /// here (out of scope — see docs/lms/LEARNING_ACTIVITIES.md limitations).
  fileSizeBytes   Int?    @map("file_size_bytes")
  /// EMBED — a typed provider identifier from a closed allowlist (e.g.
  /// "youtube", "vimeo") plus an opaque provider-specific resource ID.
  /// Never a raw iframe `src`/HTML string (Part 2C security requirement).
  embedProvider   String? @map("embed_provider") @db.VarChar(60)
  embedResourceId String? @map("embed_resource_id") @db.VarChar(200)

  status CourseModuleStatus @default(DRAFT)

  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  progress ActivityProgress[]

  @@unique([lessonId, position])
  @@index([lessonId, status])
  @@map("learning_activities")
}

/// CORRECTION (Part 2 correction pass) — real, server-derived tracking of
/// "has this enrollment viewed this activity," replacing the original
/// design defect where `ALL_ACTIVITIES_VIEWED` was silently evaluated as
/// an alias of `MANUAL` (i.e. never actually checked whether activities
/// were viewed). One row per (enrollment, activity); `viewedAt` is set by
/// the server the first time `POST /me/activities/:id/viewed` succeeds
/// (idempotent upsert — a repeat call is a no-op, never a duplicate row,
/// per the `@@unique([enrollmentId, activityId])` constraint). The client
/// NEVER supplies a "viewed" boolean directly — it reports the discrete
/// event "I viewed this specific activity," and the server aggregates
/// across every activity in a lesson to decide whether
/// `ALL_ACTIVITIES_VIEWED` is satisfied (see
/// `completion.service.ts`'s `areAllRequiredActivitiesViewed`).
model ActivityProgress {
  id           String           @id @default(uuid()) @db.Uuid
  enrollmentId String           @map("enrollment_id") @db.Uuid
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  activityId   String           @map("activity_id") @db.Uuid
  activity     LearningActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  /// Denormalized from `activity.lessonId` — avoids a join through
  /// LearningActivity on every "are all of this lesson's activities
  /// viewed" query, which the completion engine runs on the hot path of
  /// every progress/activity-view update.
  lessonId     String           @map("lesson_id") @db.Uuid

  viewedAt DateTime? @map("viewed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([enrollmentId, activityId])
  @@index([enrollmentId, lessonId])
  @@map("activity_progress")
}

// =============================================================================
// 004 US3 — Quiz System (this implementation batch). Deliberately simpler
// than spec.md's fullest FR-064 vision: Questions belong directly to ONE
// Quiz (a per-quiz question list), not a separate, cross-quiz-reusable
// "Question Bank" with tagging/randomized-set-generation-by-category —
// that reusable-bank richness is a real, separate future enhancement, not
// silently dropped; this batch ships a genuinely functional, server-graded
// quiz engine end-to-end first. A Quiz attaches 1:1 to a Lesson (FR-017's
// "Quiz" lesson type), not to a LearningActivity (LearningActivity is
// deliberately metadata-only content per Part 2A; a quiz's richer
// attempt/scoring structure does not fit that shape, the same reasoning
// that keeps Assignment/Certificate as their own future entities too).
// =============================================================================

model Quiz {
  id       String @id @default(uuid()) @db.Uuid
  lessonId String @unique @map("lesson_id") @db.Uuid
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  title        String  @db.VarChar(200)
  instructions String? @db.Text

  quizType QuizType @default(GRADED) @map("quiz_type")

  passingScorePercent Int      @default(70) @map("passing_score_percent")
  /// null = unlimited attempts.
  maxAttempts         Int?     @map("max_attempts")
  /// null = untimed.
  timeLimitMinutes    Int?     @map("time_limit_minutes")
  randomizeQuestions  Boolean  @default(false) @map("randomize_questions")
  randomizeAnswers    Boolean  @default(false) @map("randomize_answers")
  /// FR-067 "answer-review visibility controlled by an admin setting" —
  /// whether a learner sees which answers were correct after submitting.
  showCorrectAnswers  Boolean  @default(true) @map("show_correct_answers")

  status QuizStatus @default(DRAFT)

  version   Int     @default(1)
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete only — an archived/deleted Quiz must never orphan
  /// historical QuizAttempt/QuizAnswer rows.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  questions Question[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

enum QuizType {
  PRACTICE
  GRADED
  MODULE_QUIZ
  FINAL_ASSESSMENT
  CERTIFICATION_EXAM
  DIAGNOSTIC

  @@map("quiz_type")
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("quiz_status")
}

/// FR-062 question types, narrowed to the subset implementable without a
/// file-upload pipeline or a human-graded-response workflow this pass —
/// Match/Ordering/File-upload/Scenario/Audio/Video-response are explicitly
/// future-ready (same "don't preclude, don't fake" pattern used elsewhere
/// in this codebase), not silently aliased to one of these.
enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_BLANK
  SHORT_ANSWER
  NUMERIC

  @@map("question_type")
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("question_status")
}

model Question {
  id     String @id @default(uuid()) @db.Uuid
  quizId String @map("quiz_id") @db.Uuid
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  type QuestionType

  prompt      String  @db.Text
  /// Shown to the learner after submission, only if `quiz.showCorrectAnswers`.
  explanation String? @db.Text
  points      Int     @default(1)
  /// Ordering within the quiz — unique per (quizId, position).
  position    Int

  /// Type-dependent correct-answer data for NON-choice types only:
  ///  - SHORT_ANSWER/FILL_BLANK: `{ "acceptedAnswers": string[] }` — the
  ///    learner's trimmed, case-insensitive answer must match one entry.
  ///  - NUMERIC: `{ "correctValue": number, "tolerance": number }`.
  /// Choice types (SINGLE_CHOICE/MULTIPLE_CHOICE/TRUE_FALSE) use
  /// `QuestionOption.isCorrect` instead — never duplicated here.
  answerKey Json? @map("answer_key")

  status QuestionStatus @default(PUBLISHED)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete only (FR-066 edge case: "a question is deleted from the
  /// question bank after a learner already attempted the quiz containing
  /// it" — the historical `QuizAnswer` must remain valid/interpretable).
  /// An admin "delete" sets this and excludes the question from future
  /// quiz-taking; it is never physically removed.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  options QuestionOption[]
  answers QuizAnswer[]

  @@unique([quizId, position])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text      String  @db.Text
  isCorrect Boolean @default(false) @map("is_correct")
  /// Ordering within the question — unique per (questionId, position).
  position  Int

  @@unique([questionId, position])
  @@map("question_options")
}

model QuizAttempt {
  id           String     @id @default(uuid()) @db.Uuid
  quizId       String     @map("quiz_id") @db.Uuid
  quiz         Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  enrollmentId String     @map("enrollment_id") @db.Uuid
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  /// 1-based, per (enrollmentId, quizId) — FR-063 "attempts allowed".
  attemptNumber Int @map("attempt_number")

  status QuizAttemptStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  /// Computed from `quiz.timeLimitMinutes` at start time — null if untimed.
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  gradedAt    DateTime? @map("graded_at") @db.Timestamptz(6)

  pointsPossible Int?     @map("points_possible")
  pointsEarned   Int?     @map("points_earned")
  scorePercent   Int?     @map("score_percent")
  passed         Boolean?

  answers QuizAnswer[]

  /// A learner may have at most one attempt row per (enrollment, quiz,
  /// attemptNumber) — attempt numbers are assigned sequentially server-side,
  /// never client-supplied.
  @@unique([enrollmentId, quizId, attemptNumber])
  @@index([quizId])
  @@map("quiz_attempts")
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  EXPIRED

  @@map("quiz_attempt_status")
}

model QuizAnswer {
  id         String      @id @default(uuid()) @db.Uuid
  attemptId  String      @map("attempt_id") @db.Uuid
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String      @map("question_id") @db.Uuid
  /// Restrict, not Cascade — a Question is always soft-deleted (see
  /// `Question.deletedAt`), never physically removed, so this FK should
  /// never actually block a delete; it is a defensive backstop, not the
  /// primary mechanism that keeps historical answers interpretable.
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  /// Choice types — the learner's selected `QuestionOption` id(s).
  selectedOptionIds String[] @map("selected_option_ids")
  /// SHORT_ANSWER/FILL_BLANK free text, or NUMERIC's entered value
  /// (stored as text; parsed back to a number at grading time).
  answerText        String?  @map("answer_text")

  /// Null until graded (FR-066 "server calculates or queues grading").
  isCorrect     Boolean? @map("is_correct")
  pointsAwarded Int?     @map("points_awarded")

  answeredAt DateTime @default(now()) @map("answered_at") @db.Timestamptz(6)

  @@unique([attemptId, questionId])
  @@map("quiz_answers")
}

// =============================================================================
// 004 US4 — Assignment System (this implementation batch). Same "attaches
// 1:1 to a Lesson" pattern as Quiz — an Assignment is content belonging to
// a lesson, not a LearningActivity (richer submission/rubric/review
// structure doesn't fit that metadata-only shape). Rubric criteria belong
// directly to ONE assignment (no separate, cross-assignment-reusable
// Rubric template entity) — the same "ship a genuinely functional engine
// first, defer the reusable-template richness" scope reduction Quiz's
// per-quiz Question list already established for this codebase. File-
// shaped submission formats (file/image/audio/video) are link-based (the
// learner supplies a URL to already-hosted content) since no upload/
// storage/virus-scanning pipeline exists anywhere in this codebase
// (docs/lms/DECISION_GATES.md gate #31) — never a fake upload widget.
// =============================================================================

model Assignment {
  id       String @id @default(uuid()) @db.Uuid
  lessonId String @unique @map("lesson_id") @db.Uuid
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  title           String  @db.VarChar(200)
  instructions    String? @db.Text
  learningOutcome String? @map("learning_outcome") @db.VarChar(500)

  submissionFormat AssignmentSubmissionFormat @default(TEXT) @map("submission_format")
  /// Advisory only (shown to the learner alongside instructions) — there is
  /// no server-side file-type/MIME enforcement to apply it to, since
  /// submissions are link-based, not uploaded (see file header note).
  allowedFileTypes String[] @map("allowed_file_types")

  dueAt        DateTime? @map("due_at") @db.Timestamptz(6)
  maxScore     Int      @default(100) @map("max_score")
  passingScore Int      @default(70) @map("passing_score")
  latePolicy   AssignmentLatePolicy @default(ACCEPT) @map("late_policy")
  /// null = unlimited resubmissions after CHANGES_REQUESTED.
  maxAttempts  Int?     @map("max_attempts")

  status AssignmentLifecycleStatus @default(DRAFT)

  version   Int     @default(1)
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  rubricCriteria RubricCriterion[]
  submissions    Submission[]

  @@map("assignments")
}

enum AssignmentSubmissionFormat {
  TEXT
  LINK
  FILE_URL
  IMAGE_URL
  AUDIO_URL
  VIDEO_URL

  @@map("assignment_submission_format")
}

enum AssignmentLatePolicy {
  REJECT
  ACCEPT

  @@map("assignment_late_policy")
}

enum AssignmentLifecycleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("assignment_lifecycle_status")
}

model RubricCriterion {
  id           String     @id @default(uuid()) @db.Uuid
  assignmentId String     @map("assignment_id") @db.Uuid
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  title       String  @db.VarChar(200)
  description String? @db.Text
  maxPoints   Int     @default(10) @map("max_points")
  /// Ordering within the assignment — unique per (assignmentId, position).
  position    Int

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete only — a criterion already scored on a historical
  /// submission must remain interpretable (same FR-066-style guarantee
  /// Quiz's `Question.deletedAt` provides).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  scores SubmissionCriterionScore[]

  @@unique([assignmentId, position])
  @@map("rubric_criteria")
}

/// FR-072 status lifecycle. "Not started" has no row at all (no Submission
/// exists yet); "Overdue" is a derived/computed display state (dueAt has
/// passed on a still-DRAFT submission), not stored here.
model Submission {
  id           String     @id @default(uuid()) @db.Uuid
  assignmentId String     @map("assignment_id") @db.Uuid
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  enrollmentId String     @map("enrollment_id") @db.Uuid
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  /// 1-based — a resubmission after CHANGES_REQUESTED creates a NEW row
  /// (this incremented), never overwrites the prior one, so "the previous
  /// submission remains visible alongside the new one" (FR-072 acceptance
  /// scenario 2) is true by construction, not by a separate history table.
  attemptNumber Int @map("attempt_number")

  status SubmissionStatus @default(DRAFT)

  textBody String? @map("text_body") @db.Text
  /// LINK/FILE_URL/IMAGE_URL/AUDIO_URL/VIDEO_URL — see file header note.
  linkUrl  String? @map("link_url") @db.VarChar(500)

  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  /// Set at submit time by comparing `submittedAt` against the
  /// assignment's `dueAt` — never client-asserted.
  isLate      Boolean   @default(false) @map("is_late")

  score  Int?
  passed Boolean?

  reviewerId String?   @map("reviewer_id") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  /// Private — instructor/admin-only, never returned to the learner.
  reviewerNote    String? @map("reviewer_note") @db.Text
  /// Learner-facing feedback — distinct field from `reviewerNote` above,
  /// so a private note can never leak into what the learner sees.
  learnerFeedback String? @map("learner_feedback") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  criterionScores SubmissionCriterionScore[]

  @@unique([enrollmentId, assignmentId, attemptNumber])
  @@index([assignmentId, status])
  @@map("submissions")
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  EXCUSED

  @@map("submission_status")
}

model SubmissionCriterionScore {
  id           String          @id @default(uuid()) @db.Uuid
  submissionId String          @map("submission_id") @db.Uuid
  submission   Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  criterionId  String          @map("criterion_id") @db.Uuid
  /// Restrict, not Cascade — `RubricCriterion` is always soft-deleted (see
  /// its own `deletedAt`), never physically removed, so this FK should
  /// never actually block a delete; a defensive backstop, not the primary
  /// mechanism (same reasoning as `QuizAnswer.question`'s FK).
  criterion    RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  pointsAwarded Int     @map("points_awarded")
  comment       String? @db.Text

  @@unique([submissionId, criterionId])
  @@map("submission_criterion_scores")
}

// =============================================================================
// 004 US5 — Certificate System (this implementation batch). Only
// COURSE_COMPLETION is actually issuable — LearningPath/Program/Event/
// Challenge/Organization-training entities don't exist in this codebase
// yet (same "type system stays truthful even though only a subset is
// fulfilled" pattern already used for `EnrollmentSource`). "Generate a
// PDF" (FR-083) is a server-rendered, browser-printable HTML certificate
// view, NOT a binary PDF file — no PDF-generation library or file/object
// storage pipeline exists anywhere in this codebase (docs/lms/
// DECISION_GATES.md gate #31), so `Certificate` has no `pdfUrl` file
// reference; the public verification page IS the "PDF" deliverable, and
// is real, functional, and matches FR-085's actual requirement (a public,
// unauthenticated, credential-ID-driven verification view).
// =============================================================================

model CertificateTemplate {
  id   String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(200)

  /// FR-084 template fields — image/color/font references only (no
  /// upload pipeline; these are plain URLs the admin supplies, same
  /// external-URL pattern `LearningActivity.mediaUrl` already uses).
  backgroundUrl String? @map("background_url") @db.VarChar(500)
  logoUrl       String? @map("logo_url") @db.VarChar(500)
  signatureUrl  String? @map("signature_url") @db.VarChar(500)
  sealUrl       String? @map("seal_url") @db.VarChar(500)
  fontFamily    String? @map("font_family") @db.VarChar(100)
  primaryColor  String? @map("primary_color") @db.VarChar(20)
  language      String  @default("EN") @db.VarChar(10)

  isActive Boolean @default(true) @map("is_active")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  courses      Course[]
  certificates Certificate[]

  @@map("certificate_templates")
}

model Certificate {
  id           String     @id @default(uuid()) @db.Uuid
  courseId     String     @map("course_id") @db.Uuid
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollmentId String     @unique @map("enrollment_id") @db.Uuid
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  /// FR-082 "unique verification code" — public-facing, short, distinct
  /// from the internal UUID `id` (never expose the raw DB id as the
  /// credential a learner shares — same "opaque public identifier"
  /// discipline as `Enrollment`'s own internal-vs-public id split
  /// elsewhere in this schema).
  credentialId String @unique @map("credential_id") @db.VarChar(40)

  certificateType CertificateType @default(COURSE_COMPLETION) @map("certificate_type")

  /// FR-082/FR-086 Historical Immutability (Constitution Article IV) —
  /// learner/course/instructor/organization names are SNAPSHOTTED at
  /// issuance time, never a live join. A later profile-name change or
  /// course-title edit must never retroactively alter an already-issued
  /// certificate.
  learnerName      String  @map("learner_name") @db.VarChar(200)
  courseTitle      String  @map("course_title") @db.VarChar(200)
  instructorName   String? @map("instructor_name") @db.VarChar(200)
  organizationName String? @map("organization_name") @db.VarChar(200)

  completionDate DateTime  @map("completion_date") @db.Timestamptz(6)
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)

  status CertificateStatus @default(VALID)

  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy     String?   @map("revoked_by") @db.Uuid
  revokedReason String?   @map("revoked_reason") @db.Text

  templateId String?              @map("template_id") @db.Uuid
  template   CertificateTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /// SC-002 "100% of certificates issued have a system-recorded, server-
  /// evaluated eligibility snapshot showing every configured eligibility
  /// condition was met at issuance time." See `certificate.service.ts`'s
  /// `evaluateCertificateEligibility` for exactly which FR-081 conditions
  /// this codebase can actually verify vs. honestly reports as not
  /// applicable (no owning system exists yet).
  eligibilitySnapshot Json @map("eligibility_snapshot")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([courseId])
  @@map("certificates")
}

enum CertificateType {
  COURSE_COMPLETION
  LEARNING_PATH
  PROGRAM_COMPLETION
  SKILL_CERTIFICATION
  EVENT_PARTICIPATION
  CHALLENGE_COMPLETION
  ORGANIZATION_TRAINING

  @@map("certificate_type")
}

/// "Not found" (FR-085) is not a stored status — it is what the public
/// verification endpoint returns when no Certificate matches the
/// requested credential ID at all.
enum CertificateStatus {
  VALID
  EXPIRED
  REVOKED
  REPLACED

  @@map("certificate_status")
}

/// FR-021 access-grant SOURCE taxonomy, modeled exactly as FR-021 lists it
/// (so the type system stays truthful even though Part 2 can only actually
/// FULFILL a subset of these — see entitlement.service.ts). MEMBERSHIP,
/// PURCHASE, PROGRAM, ORGANIZATION, COUPON, SCHOLARSHIP, TRIAL, and INVITE
/// all exist as valid taxonomy values a future Feature 009/007 integration
/// can populate, but `entitlement.service.ts`'s `evaluateEntitlement()`
/// deterministically returns `UNAVAILABLE` (fail-closed) for every one of
/// them in Part 2 — no LMS code path here ever fabricates approval for
/// them. Only FREE (learner self-enroll on a FREE-priced course) and
/// ADMIN_GRANT (an administrator's own authority IS the entitlement
/// decision) are actually grantable in Part 2.
enum EnrollmentSource {
  FREE
  MEMBERSHIP
  PURCHASE
  PROGRAM
  ORGANIZATION
  ADMIN_GRANT
  COUPON
  SCHOLARSHIP
  TRIAL
  INVITE

  @@map("enrollment_source")
}

/// FR-023 Access States, narrowed to what an Enrollment ROW's own lifecycle
/// status needs to express (FR-023's "Eligible-not-enrolled" is a pre-
/// enrollment computed state, never stored; "Refunded" is deferred to
/// Feature 009 — see CANCELLED doc comment below).
enum EnrollmentStatus {
  /// Created but not yet activated (e.g. awaiting a future entitlement
  /// resolution) — FREE/ADMIN_GRANT enrollments in Part 2 move directly to
  /// ACTIVE and never actually rest in PENDING, but the state remains
  /// valid for a future entitlement source that has an approval delay.
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  /// LMS-owned cancellation (admin/withdrawal), distinct from a payment
  /// REFUND — refund policy/logic is explicitly Feature 009's territory
  /// (Part 2B/2C stop-list: "no refund logic"). A future Feature 009
  /// refund event is expected to call into this same CANCELLED transition
  /// via its own integration code, not reimplement it here.
  CANCELLED
  COMPLETED
  REVOKED

  @@map("enrollment_status")
}

/// FR-021–033 — the record of a learner's access grant to a Course.
/// Typed enums/timestamps throughout (never a JSON blob) per Part 2B's
/// explicit "typed enums not JSON" instruction. See
/// docs/lms/ENROLLMENT_LIFECYCLE.md for the full state machine and
/// docs/lms/ENTITLEMENT_BOUNDARY.md for why `entitlementReference` is a
/// loose opaque string, not a Feature-009 foreign key that doesn't exist.
model Enrollment {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String @map("course_id") @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  source EnrollmentSource
  status EnrollmentStatus @default(PENDING)

  /// Opaque reference to whatever granted this enrollment — an admin actor
  /// ID for ADMIN_GRANT, or (in a future Feature 009 integration) an order/
  /// membership/coupon ID. LMS does not define or own the referenced
  /// record's schema (Part 2C: "no Order/Payment/Invoice model is added by
  /// LMS").
  entitlementReference String? @map("entitlement_reference") @db.VarChar(200)

  enrolledAt     DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  activatedAt    DateTime? @map("activated_at") @db.Timestamptz(6)
  /// Access window — FR-024. Null accessStartAt = immediately available;
  /// null accessEndAt = lifetime access.
  accessStartAt  DateTime? @map("access_start_at") @db.Timestamptz(6)
  accessEndAt    DateTime? @map("access_end_at") @db.Timestamptz(6)
  suspendedAt    DateTime? @map("suspended_at") @db.Timestamptz(6)
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Server-derived only (completion.service.ts) — never client-settable.
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  expiredAt      DateTime? @map("expired_at") @db.Timestamptz(6)
  lastAccessedAt DateTime? @map("last_accessed_at") @db.Timestamptz(6)

  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lessonProgress      LessonProgress[]
  completionOverrides CompletionOverride[]
  activityProgress    ActivityProgress[]
  quizAttempts        QuizAttempt[]
  submissions         Submission[]
  /// 004 US5 (Certificate System batch) — at most one certificate per
  /// enrollment (this batch only issues COURSE_COMPLETION certificates).
  certificate         Certificate?

  // NOTE: "one ACTIVE/PENDING enrollment per (userId, courseId)" is enforced
  // by a hand-added PARTIAL unique index in the migration (Prisma's DSL
  // cannot express a WHERE-scoped unique constraint) — same pattern as
  // Part 1's `course_instructors_one_primary_per_course` index. A CANCELLED/
  // REVOKED/EXPIRED enrollment does NOT block a new enrollment row for the
  // same (user, course) — e.g. re-enrolling after a revoke.
  @@index([userId, status])
  @@index([courseId, status])
  @@map("enrollments")
}

/// FR-052/FR-054 — per-learner, per-lesson completion state (the "Lesson
/// Progress" key entity). Course/Module/Path progress are DELIBERATELY
/// DERIVED at read time from this table (see progress.service.ts's
/// `computeModuleProgress`/`computeCourseProgress`), not separately stored
/// — avoids a second, driftable source of truth that would need to be kept
/// in lockstep with every LessonProgress write. See
/// docs/lms/PROGRESS_ENGINE.md "Why progress is derived, not stored" for
/// the full reasoning (Part 2B explicitly asked the reviewer to decide
/// this; this is the resolved decision).
model LessonProgress {
  id           String     @id @default(uuid()) @db.Uuid
  enrollmentId String     @map("enrollment_id") @db.Uuid
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String     @map("lesson_id") @db.Uuid
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  status           LessonProgressStatus @default(NOT_STARTED)
  /// 0–100, always SERVER-DERIVED (never a client-supplied absolute value
  /// accepted verbatim) — see progress.service.ts's anti-rollback clamp.
  percentage       Int                  @default(0)
  timeSpentSeconds Int                  @default(0) @map("time_spent_seconds")
  /// Typed-at-the-application-layer learning position (validated/bounded by
  /// `progress.validation.ts`'s `lastPositionSchema` discriminated union by
  /// activity kind) — stored as Json here only because its shape varies by
  /// activity type (video position vs. article scroll vs. PDF page), the
  /// same "enum type decides shape" pattern as Part 1's
  /// `releaseRuleValue`/`completionRuleValue`.
  lastPosition     Json?                @map("last_position")

  startedAt        DateTime?               @map("started_at") @db.Timestamptz(6)
  lastAccessedAt   DateTime?               @map("last_accessed_at") @db.Timestamptz(6)
  /// Server-derived only — never accepted directly from a client payload.
  completedAt      DateTime?               @map("completed_at") @db.Timestamptz(6)
  completionSource LessonCompletionSource? @map("completion_source")

  /// Optimistic-concurrency guard for the progress-update endpoint (Part 2B
  /// "transaction/concurrency safety") — incremented on every update.
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@index([lessonId])
  @@index([enrollmentId, lastAccessedAt])
  @@map("lesson_progress")
}

/// FR-052/FR-054 — deliberately only the 3 states Part 2B's brief allows
/// without further clarification ("not started/in progress/completed only,
/// unless spec requires more") — FR-072's richer Assignment-status list is
/// a DIFFERENT entity (Submission, Part 3/assignments) and not reused here.
enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED

  @@map("lesson_progress_status")
}

/// Who/what satisfied a lesson's completion — an audit-relevant provenance
/// tag distinct from the completion RULE type (LessonCompletionRuleType)
/// configured on the Lesson itself.
enum LessonCompletionSource {
  /// Learner explicitly clicked "mark complete" (completionRuleType=MANUAL).
  MANUAL_LEARNER
  /// Server evaluated a configured signal (e.g. MINIMUM_WATCH_PERCENT met)
  /// and derived completion — never a raw "video opened" event (004
  /// FR-053/SC-001 — Constitution Article IX).
  SIGNAL_DERIVED
  INSTRUCTOR_OVERRIDE
  ADMIN_OVERRIDE

  @@map("lesson_completion_source")
}

/// FR-113 — "Authorized admin/instructor roles MUST be able to override
/// progress... each requiring a stated reason, sufficient permission, an
/// audit entry." A generic, reusable override record (rather than a
/// bespoke table per scope) — LESSON/MODULE/COURSE scope plus a
/// MARK_COMPLETE/RESET action, always reason + actor + before/after
/// snapshot. Consumed by completion.service.ts to answer "was this
/// MODULE/COURSE ever manually approved/completed" for the
/// INSTRUCTOR_APPROVAL completion-rule case, and to let an admin RESET a
/// learner's progress with a full audit trail.
model CompletionOverride {
  id           String     @id @default(uuid()) @db.Uuid
  enrollmentId String     @map("enrollment_id") @db.Uuid
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  scope    CompletionOverrideScope
  /// The Lesson/CourseModule/Course id this override targets, depending on
  /// `scope` — not a typed FK (the target table varies), the same
  /// "loose reference by design" pattern Part 1 uses for `createdBy`/
  /// `reviewedBy` actor references.
  targetId String                   @map("target_id") @db.Uuid
  action   CompletionOverrideAction

  reason        String   @db.VarChar(1000)
  actorId       String   @map("actor_id") @db.Uuid
  previousValue Json?    @map("previous_value")
  newValue      Json?    @map("new_value")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([enrollmentId, scope, targetId])
  @@map("completion_overrides")
}

enum CompletionOverrideScope {
  LESSON
  MODULE
  COURSE

  @@map("completion_override_scope")
}

enum CompletionOverrideAction {
  MARK_COMPLETE
  RESET

  @@map("completion_override_action")
}

// ============================================================================
// Billing Foundation — Phase 7 Part 1 (009-membership-payments-revenue).
//
// Scope: ONLY the sellable-item catalog and membership-plan/entitlement
// CONFIGURATION foundation (spec.md FR-001–FR-014) — Product, ProductPrice,
// MembershipPlan, PlanVersion, PlanEntitlement. Checkout, orders, payment
// processing, subscriptions (the runtime relationship a customer HOLDS to
// a plan), webhooks, invoices, refunds, wallet, coupons, referral,
// affiliate, and the financial ledger are explicitly Part 2+ — no
// placeholder tables for them exist here (see docs/billing/DECISION_GATES.md).
//
// Architecture: same Express + Prisma + Zod + AppError + deny-by-default
// RBAC + AuditEvent foundation as every prior phase — 009/plan.md's own
// NestJS + unified `web/` Next.js assumption is not followed, same
// accepted-decision-gate pattern as Phases 4–6 (see docs/auth/DECISION_GATES.md
// gate #1 and docs/billing/ARCHITECTURE.md).
// ============================================================================

// ----------------------------------------------------------------------------
// Product — any sellable item (FR-001, FR-002). A membership (FR-002's
// MEMBERSHIP_* types) additionally links to exactly one MembershipPlan for
// its plan-specific tier/entitlement/policy configuration; every other
// product type stands alone at this phase (no course/event/mentor-session
// FK back-reference yet — those features don't consume this catalog until
// their own later phase wires the link).
// ----------------------------------------------------------------------------
model Product {
  id String @id @default(uuid()) @db.Uuid

  code String @unique @db.VarChar(60)
  name String @db.VarChar(200)
  slug String @unique @db.VarChar(220)

  type ProductType

  description      String?  @db.Text
  shortDescription String?  @map("short_description") @db.VarChar(300)
  mediaUrls        String[] @map("media_urls")

  /// Admin-configurable free-form catalog grouping (FR-001 "category") —
  /// deliberately a plain string, not an enum/FK: FR-002's product `type`
  /// is already the closed taxonomy; "category" is a looser, admin-defined
  /// display grouping on top of it (e.g. "Learning", "Community", "AI")
  /// with no further structure specified by the spec.
  category String? @db.VarChar(100)

  /// Nullable — most products are platform-owned (no external seller); set
  /// only for a marketplace-style seller/revenue-owner product (FR-001).
  /// Loose reference by design (no FK), same pattern as `createdBy` below.
  sellerId String? @map("seller_id") @db.Uuid

  pricingModel     ProductPricingModel     @map("pricing_model")
  currency         String                  @default("INR") @db.VarChar(3)
  taxCategory      String?                 @map("tax_category") @db.VarChar(60)
  fulfilmentMethod ProductFulfilmentMethod @default(INSTANT) @map("fulfilment_method")

  availabilityStartAt DateTime? @map("availability_start_at") @db.Timestamptz(6)
  availabilityEndAt   DateTime? @map("availability_end_at") @db.Timestamptz(6)
  maxQuantity         Int?      @map("max_quantity")

  refundPolicy String? @map("refund_policy") @db.Text
  termsVersion String? @map("terms_version") @db.VarChar(40)

  /// 001 FR-062/FR-063, Constitution Article III — mandatory, visible
  /// disclosure BEFORE any price/CTA renders. `sponsorLabel`/
  /// `affiliateDisclosure` are the exact text shown; a null label with
  /// the boolean true falls back to a generic default in the disclosure
  /// service rather than rendering nothing.
  isSponsored         Boolean @default(false) @map("is_sponsored")
  sponsorLabel        String? @map("sponsor_label") @db.VarChar(120)
  isAffiliate         Boolean @default(false) @map("is_affiliate")
  affiliateDisclosure String? @map("affiliate_disclosure") @db.VarChar(300)

  /// FR-003: only APPROVED/ACTIVE products may ever appear at public
  /// checkout — enforced in the public-read repository query, not just
  /// documented here (Part 1 has no checkout, but the public pricing API
  /// applies the identical visibility rule).
  status ProductStatus @default(DRAFT)

  version Int @default(1)

  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  prices         ProductPrice[]
  membershipPlan MembershipPlan?
  /// 002 US4 — checkout-state tracking sessions initiated for this product.
  checkoutSessions CheckoutSession[]

  @@index([type, status])
  @@index([status])
  @@map("products")
}

enum ProductType {
  MEMBERSHIP_INDIVIDUAL
  MEMBERSHIP_TEAM
  MEMBERSHIP_ORGANIZATION
  COURSE
  COURSE_BUNDLE
  COHORT_PROGRAM
  WORKSHOP
  EVENT_TICKET
  MENTOR_SESSION
  MENTOR_PACKAGE
  EBOOK
  TEMPLATE
  DIGITAL_TOOLKIT
  PODCAST_PREMIUM
  AI_CREDITS
  AI_SUBSCRIPTION_ADDON
  CERTIFICATION_FEE
  CHALLENGE_ENTRY
  MERCHANDISE
  GIFT_MEMBERSHIP
  CUSTOM

  @@map("product_type")
}

enum ProductPricingModel {
  FREE
  ONE_TIME_FIXED
  RECURRING_FIXED
  USAGE_BASED
  PER_SEAT
  TIERED
  PACKAGE
  PAY_WHAT_YOU_WANT
  CUSTOM_QUOTE
  INSTALLMENT
  DEPOSIT_PLUS_BALANCE
  ADD_ON
  CREDIT_BASED_REDEMPTION
  POINTS_PLUS_CASH
  PROMOTIONAL_TEMPORARY

  @@map("product_pricing_model")
}

enum ProductFulfilmentMethod {
  INSTANT
  MANUAL
  SCHEDULED

  @@map("product_fulfilment_method")
}

enum ProductStatus {
  DRAFT
  REVIEW_PENDING
  APPROVED
  SCHEDULED
  ACTIVE
  PAUSED
  SOLD_OUT
  EXPIRED
  ARCHIVED
  REJECTED

  @@map("product_status")
}

// ----------------------------------------------------------------------------
// ProductPrice — a versioned price tied to a Product (FR-005, FR-007).
// FR-006: a published (ACTIVE) price is never edited in place — the
// service layer creates a new row sharing `priceLineageId` with an
// incremented `version` instead of mutating an existing one.
// ----------------------------------------------------------------------------
model ProductPrice {
  id String @id @default(uuid()) @db.Uuid

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Ties every version of "the same conceptual price" together across
  /// FR-006's never-edit-published-price rule — see doc comment above.
  priceLineageId String @default(uuid()) @map("price_lineage_id") @db.Uuid
  version        Int    @default(1)

  currency        String           @db.VarChar(3)
  unitAmountMinor Int              @map("unit_amount_minor")
  taxInclusion    TaxInclusionType @default(EXCLUSIVE) @map("tax_inclusion")
  billingInterval BillingInterval  @map("billing_interval")
  intervalCount   Int              @default(1) @map("interval_count")
  trialPeriodDays Int?             @map("trial_period_days")
  setupFeeMinor   Int?             @map("setup_fee_minor")
  minQuantity     Int?             @map("min_quantity")
  maxQuantity     Int?             @map("max_quantity")

  effectiveStartAt DateTime? @map("effective_start_at") @db.Timestamptz(6)
  effectiveEndAt   DateTime? @map("effective_end_at") @db.Timestamptz(6)

  region      String? @db.VarChar(60)
  userSegment String? @map("user_segment") @db.VarChar(60)

  /// FR-005 "provider price reference" — the payment provider's own price
  /// ID once Part 2's provider integration exists; always null in Part 1.
  providerPriceReference String? @map("provider_price_reference") @db.VarChar(200)

  status PriceStatus @default(DRAFT)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([productId, status])
  @@index([priceLineageId])
  @@map("product_prices")
}

enum TaxInclusionType {
  INCLUSIVE
  EXCLUSIVE

  @@map("tax_inclusion_type")
}

enum BillingInterval {
  ONE_TIME
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
  MULTI_YEAR
  CUSTOM_CONTRACT

  @@map("billing_interval")
}

enum PriceStatus {
  DRAFT
  ACTIVE
  SCHEDULED
  EXPIRED
  ARCHIVED

  @@map("price_status")
}

// ----------------------------------------------------------------------------
// MembershipPlan — the stable identity for a membership tier (FR-008,
// FR-009). Admin-configurable tier structure, not a hardcoded enum: `code`
// is any unique admin-chosen string (e.g. `free`, `member`, `premium`),
// never a fixed list. One-to-one with a Product of a MEMBERSHIP_* type —
// the Product carries generic catalog/pricing fields (via ProductPrice),
// this carries plan-specific tier configuration via PlanVersion.
// ----------------------------------------------------------------------------
model MembershipPlan {
  id String @id @default(uuid()) @db.Uuid

  code String @unique @db.VarChar(60)

  productId String  @unique @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  status       MembershipPlanStatus @default(DRAFT)
  displayOrder Int                  @default(0) @map("display_order")

  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions PlanVersion[]

  @@index([status, displayOrder])
  @@map("membership_plans")
}

enum MembershipPlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED

  @@map("membership_plan_status")
}

// ----------------------------------------------------------------------------
// PlanVersion — an immutable, versioned snapshot of a MembershipPlan's
// tier configuration (plan.md Key Entities: "versioned for migration
// control"; FR-010). At most one version per plan may be PUBLISHED at a
// time — enforced at the service layer (publishing a version atomically
// archives the previously-published one in the same transaction) AND by a
// partial unique index in this migration's raw SQL
// (`plan_versions_one_published_per_plan`), same "two-layer guarantee"
// pattern as `course_instructors_one_primary_per_course` (Prisma has no
// `@@unique(... WHERE ...)` syntax — see docs/lms/DATA_MODEL.md for the
// precedent this follows).
// ----------------------------------------------------------------------------
model PlanVersion {
  id String @id @default(uuid()) @db.Uuid

  planId String         @map("plan_id") @db.Uuid
  plan   MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  versionNumber Int @map("version_number")

  name                 String  @db.VarChar(200)
  publicDescription    String? @map("public_description") @db.Text
  internalDescription  String? @map("internal_description") @db.Text
  targetCustomer       String? @map("target_customer") @db.VarChar(300)

  features String[]
  limits   Json?

  supportedBillingIntervals BillingInterval[] @map("supported_billing_intervals")

  trialEligible Boolean @default(false) @map("trial_eligible")
  trialDays     Int?    @map("trial_days")

  /// FR-010 upgrade/downgrade/cancellation/grace-period/refund policy
  /// CONFIGURATION only — the actual execution engines belong to Part 2+'s
  /// billing-subscription module; stored here so the plan comparison page
  /// can display accurate terms today (FR-013).
  upgradePaths       Json?   @map("upgrade_paths")
  downgradePaths     Json?   @map("downgrade_paths")
  cancellationPolicy String? @map("cancellation_policy") @db.Text
  gracePeriodPolicy  String? @map("grace_period_policy") @db.Text
  refundPolicy       String? @map("refund_policy") @db.Text

  badgeText String? @map("badge_text") @db.VarChar(60)

  /// FR-013: "any recommended label MUST be driven by a truthful,
  /// server-evaluated business rule." Part 1 has no subscription/usage
  /// data yet to compute real popularity from, so this is an explicit,
  /// server-stored, non-client-settable REASON code (never a bare
  /// boolean an admin flips arbitrarily) — see docs/billing/DECISION_GATES.md
  /// for why a usage-data-driven rule is deferred to Part 2+.
  recommendedReason RecommendedReason? @map("recommended_reason")

  status      PlanVersionStatus @default(DRAFT)
  publishedAt DateTime?         @map("published_at") @db.Timestamptz(6)
  archivedAt  DateTime?         @map("archived_at") @db.Timestamptz(6)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  entitlements PlanEntitlement[]

  @@unique([planId, versionNumber])
  @@index([planId, status])
  @@map("plan_versions")
}

enum PlanVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("plan_version_status")
}

enum RecommendedReason {
  BEST_VALUE
  MOST_POPULAR
  EDITOR_CHOICE

  @@map("plan_recommended_reason")
}

// ----------------------------------------------------------------------------
// PlanEntitlement — a specific capability/limit a PlanVersion grants
// (FR-012). This is catalog CONFIGURATION only — "what does holding this
// plan entitle a customer to" — never a per-user runtime grant record;
// the actual grant-checking against a live Subscription is Part 2+'s
// billing-catalog entitlement service, which this table's rows feed once
// Subscription exists (see docs/lms/ENTITLEMENT_BOUNDARY.md for the exact
// LMS-side consumer boundary this was written against).
// ----------------------------------------------------------------------------
model PlanEntitlement {
  id String @id @default(uuid()) @db.Uuid

  planVersionId String      @map("plan_version_id") @db.Uuid
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  key   String          @db.VarChar(120)
  type  EntitlementType
  value Json

  description  String? @db.Text
  displayOrder Int     @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([planVersionId, key])
  @@index([planVersionId])
  @@map("plan_entitlements")
}

enum EntitlementType {
  BOOLEAN_ACCESS
  NUMERIC_QUOTA
  CURRENCY_CREDIT
  PERCENTAGE_DISCOUNT
  CONTENT_SCOPE
  ROLE_GRANT
  TIME_LIMITED_ACCESS
  USAGE_RESET
  SEAT_BASED_ACCESS
  REGION_RESTRICTED_ACCESS

  @@map("entitlement_type")
}

// ============================================================================
// 002-public-website-marketing-funnel — Lead capture, Webinar/Masterclass
// registration, and Checkout-state tracking. Per spec.md's own Assumptions,
// this feature owns funnel UI/tracking only — actual payment processing,
// tax/coupon computation, and entitlement resolution remain 009's; a Coupon
// here is validation-only scaffolding for the checkout UI, not a billing
// engine. UTM/campaign attribution is stored INLINE on Lead/CheckoutSession
// (FR-097) rather than a separate Campaign-registry entity — a full
// campaign-definition registry (budgets, schedules) is a marketing-ops
// concern more naturally owned by a later Volume 14 feature; this scope
// only needs attribution CAPTURED and preserved, which inline fields do.
// ============================================================================

/// A captured prospect from the lead-magnet funnel (Funnel A) — FR-055/056.
/// Consent is NOT duplicated here: a Lead's marketing-email consent is a
/// real `ConsentRecord` row (channel=MARKETING_EMAIL, matched by email),
/// reusing the existing per-channel/versioned consent model instead of a
/// second, competing boolean flag (Constitution Article VI).
model Lead {
  id String @id @default(uuid()) @db.Uuid

  email       String  @db.VarChar(255)
  name        String? @db.VarChar(200)
  mobile      String? @db.VarChar(20)
  profession  String? @db.VarChar(120)
  businessStage String? @map("business_stage") @db.VarChar(60)
  interest    String? @db.VarChar(120)

  /// Which lead magnet (identified by its CMS Page slug) captured this lead.
  leadMagnetSlug String @map("lead_magnet_slug") @db.VarChar(191)

  // --- FR-097: campaign attribution, captured at the moment of capture ---
  utmSource   String? @map("utm_source") @db.VarChar(120)
  utmMedium   String? @map("utm_medium") @db.VarChar(120)
  utmCampaign String? @map("utm_campaign") @db.VarChar(120)
  utmTerm     String? @map("utm_term") @db.VarChar(120)
  utmContent  String? @map("utm_content") @db.VarChar(120)
  referralCode String? @map("referral_code") @db.VarChar(60)
  affiliateId  String? @map("affiliate_id") @db.VarChar(60)
  landingPageVariant String? @map("landing_page_variant") @db.VarChar(60)

  /// FR-024 idempotency-adjacent: a double-submit within a short window is
  /// deduped by this (leadMagnetSlug, email) uniqueness rather than a
  /// generic idempotency-key header — a lead capture form has no client
  /// SDK to attach one, unlike the authenticated LMS/billing APIs.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([leadMagnetSlug, email])
  @@index([createdAt])
  @@map("leads")
}

/// Funnel B (Webinar/Masterclass) configuration attached to a masterclass
/// landing Page — deliberately NOT a general Event/Webinar platform entity
/// (that is 010-events-webinars-live's ownership); this is scoped tightly
/// to "one CMS page can run one registration-gated masterclass," the exact
/// shape spec.md's US3 describes, reusing the existing Page infrastructure
/// rather than building a parallel content type.
model MasterclassConfig {
  id     String @id @default(uuid()) @db.Uuid
  pageId String @unique @map("page_id") @db.Uuid
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  scheduledAt           DateTime  @map("scheduled_at") @db.Timestamptz(6)
  /// FR-058/FR-112: the ONLY source for a registration countdown — never
  /// client-fabricated.
  registrationClosesAt  DateTime? @map("registration_closes_at") @db.Timestamptz(6)
  /// Null = unlimited seats (no scarcity claim rendered).
  seatLimit             Int?      @map("seat_limit")
  speakerName           String?   @map("speaker_name") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  registrations MasterclassRegistration[]

  @@map("masterclass_configs")
}

model MasterclassRegistration {
  id       String            @id @default(uuid()) @db.Uuid
  configId String            @map("config_id") @db.Uuid
  config   MasterclassConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  name             String  @db.VarChar(200)
  email            String  @db.VarChar(255)
  mobile           String? @db.VarChar(20)
  city             String? @db.VarChar(120)
  profession       String? @db.VarChar(120)
  experienceLevel  String? @map("experience_level") @db.VarChar(60)
  referralCode     String? @map("referral_code") @db.VarChar(60)

  registeredAt DateTime @default(now()) @map("registered_at") @db.Timestamptz(6)

  /// FR-046 edge case: duplicate registration by the same identity is
  /// rejected at this unique constraint, not just a client-side check.
  @@unique([configId, email])
  @@index([configId])
  @@map("masterclass_registrations")
}

/// FR-065–071: checkout/payment-STATE tracking only. Real payment
/// processing, tax computation, and entitlement grants remain 009's — this
/// row reflects state for the UI and records abandonment; it is never
/// itself the authority that grants access (Constitution Article I).
model CheckoutSession {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @map("user_id") @db.Uuid
  email  String? @db.VarChar(255)

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  status         CheckoutSessionStatus @default(NOT_STARTED)
  lastCompletedStep String?            @map("last_completed_step") @db.VarChar(60)
  cartValueMinor Int?                  @map("cart_value_minor")
  currency       String                @default("INR") @db.VarChar(3)

  couponCode String? @map("coupon_code") @db.VarChar(60)

  utmSource   String? @map("utm_source") @db.VarChar(120)
  utmMedium   String? @map("utm_medium") @db.VarChar(120)
  utmCampaign String? @map("utm_campaign") @db.VarChar(120)

  /// Set once the session has been idle past the abandonment threshold —
  /// FR-071. A recovery send (US8, deferred this pass) would consult
  /// `recoveryEmailSentAt` + the lead/user's ConsentRecord before sending;
  /// the field exists now so that future work has somewhere to record it
  /// without a later migration.
  abandonedAt         DateTime? @map("abandoned_at") @db.Timestamptz(6)
  recoveryEmailSentAt DateTime? @map("recovery_email_sent_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([abandonedAt])
  @@map("checkout_sessions")
}

enum CheckoutSessionStatus {
  NOT_STARTED
  PROCESSING
  REQUIRES_ACTION
  SUCCESS
  FAILED
  CANCELLED
  PENDING
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("checkout_session_status")
}

/// Checkout-UI validation scaffolding only (FR-066, edge case
/// COUPON_EXPIRED/COUPON_INVALID) — NOT a commission/discount-computation
/// engine; the actual charge amount after discount is 009's to compute.
model Coupon {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(60)

  discountType  CouponDiscountType @map("discount_type")
  /// Percentage (0-100) when PERCENTAGE, minor-unit amount when FIXED_AMOUNT.
  discountValue Int                @map("discount_value")

  validFrom      DateTime? @map("valid_from") @db.Timestamptz(6)
  validUntil     DateTime? @map("valid_until") @db.Timestamptz(6)
  maxRedemptions Int?      @map("max_redemptions")
  redemptionCount Int      @default(0) @map("redemption_count")

  status CouponStatus @default(ACTIVE)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("coupons")
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("coupon_discount_type")
}

enum CouponStatus {
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED

  @@map("coupon_status")
}

// ============================================================================
// 003-auth-identity-onboarding-dashboard — Onboarding sequencer + Roadmap.
// 001 already built `UserLifecycleState` (a flat capture of the SAME goal/
// experience/business-stage/etc answers, used by its Next-Best-Action
// resolver) — this feature does NOT duplicate that data. Instead it adds
// the STEP-BY-STEP progress/resume tracking 001 never needed (001 only
// cared about the current values, not "which of the 13 steps is the user
// on"), and writes the SAME answers into `UserLifecycleState` as a side
// effect of completing the relevant step, so 001's NBA engine keeps working
// unchanged. `Assessment`/`AssessmentResult` are deliberately folded into
// `OnboardingStepResponse` (step 11's answer payload) rather than a
// separate configurable branching-engine entity — no admin-configurable
// assessment builder is in scope this pass (see plan.md's own "detailed
// A/B testing... more fully specified in Volume 14" precedent for scoping
// down a configurable-engine requirement to its actually-needed subset).
// ============================================================================

model OnboardingStepResponse {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 1=Welcome, 2=Language, 3=Goal, 4=UserType, 5=Experience, 6=BusinessStage,
  /// 7=Interests, 8=TimeAvailability, 9=Format, 10=Challenge, 11=Assessment
  /// (optional). Steps 12 (Roadmap) and 13 (Recommended First Action) are
  /// system-GENERATED output, not a user answer — see `Roadmap` below.
  stepNumber Int    @map("step_number")
  stepKey    String @map("step_key") @db.VarChar(40)
  answer     Json

  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)

  @@unique([userId, stepNumber])
  @@index([userId])
  @@map("onboarding_step_responses")
}

model Roadmap {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goalSummary             String  @map("goal_summary") @db.Text
  currentStage            String  @map("current_stage") @db.VarChar(60)
  recommendedLearningPath String? @map("recommended_learning_path") @db.VarChar(200)
  recommendedFirstCourseSlug String? @map("recommended_first_course_slug") @db.VarChar(220)
  recommendedCommunityGroup String? @map("recommended_community_group") @db.VarChar(200)
  recommendedChallenge    String? @map("recommended_challenge") @db.VarChar(200)
  recommendedEvent        String? @map("recommended_event") @db.VarChar(200)
  recommendedAiTool       String? @map("recommended_ai_tool") @db.VarChar(200)
  expectedWeeklyCommitment String? @map("expected_weekly_commitment") @db.VarChar(120)
  firstMilestone          String  @map("first_milestone") @db.VarChar(300)

  /// FR-095, Constitution Article II: AI-generated roadmaps MUST always
  /// have a deterministic fallback — this field records which path
  /// actually produced THIS roadmap, never fabricated as "AI" if the
  /// fallback engaged.
  generatedBy RoadmapGenerationSource @map("generated_by")

  generatedAt DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("roadmaps")
}

enum RoadmapGenerationSource {
  AI
  DETERMINISTIC_FALLBACK

  @@map("roadmap_generation_source")
}
