// CoachX Enterprise Platform — Prisma Schema
//
// Phase 1 (Project Foundation) scope: datasource + generator only.
// No feature/domain models are defined here yet — those are added
// feature-by-feature in later implementation phases, following the
// entity definitions in `specs/<feature>/spec.md` and the ownership
// boundaries recorded in each feature's `plan.md`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

